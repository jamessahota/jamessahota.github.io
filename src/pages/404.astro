---
import ButtonLink from '../components/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found. Browse James Sahota’s research, experience and CV instead."
  noindex
>
  <div class="container not-found">
    <p class="label label--marked">Error 404</p>
    <h1 class="display">Not found</h1>
    <p class="lede">This page may have moved, or the address may be incorrect. Browse my research or return to the homepage.</p>
    <div class="not-found__actions">
      <ButtonLink href="/research/" label="Browse research" icon="arrow-right" />
      <ButtonLink href="/" label="Go to the homepage" variant="secondary" />
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-top: var(--section);
  }

  h1 {
    margin-top: var(--space-4);
  }

  .lede {
    margin-top: var(--space-5);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>

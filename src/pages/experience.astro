---
import Icon from '../components/Icon.astro';
import ButtonLink from '../components/ButtonLink.astro';
import RoleEntry from '../components/RoleEntry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCapabilities,
  getEducation,
  getExperience,
  getProfile,
  getPublicProjects,
  projectPath,
} from '../lib/content';
import { formatPeriod } from '../lib/dates';

const roles = await getExperience();
const education = await getEducation();
const capabilities = await getCapabilities();
const projects = await getPublicProjects();
const profile = await getProfile();

const description =
  'Experience and education of James Sahota: co-founder of 6:05 Markets, research contributor at Energy Flux, and a mathematics and economics student at the University of Chicago.';
---

<BaseLayout title="Experience" description={description}>
  <header class="page-header container experience-header">
    <p class="label label--marked">Roles, education and skills</p>
    <h1 class="display">Experience</h1>
    <div class="experience-header__lower">
      <p class="lede">
        I co-founded 6:05 Markets and develop research with Energy Flux. My experience also includes
        wealth services at HBL Bank UK and energy-research leadership at UChicago Commodities.
      </p>
      <ButtonLink href="/cv/" label="View CV" icon="arrow-up-right" />
    </div>
    <nav class="experience-jumps side-scroll" aria-label="On this page">
      <a href="#roles-heading">Roles <Icon name="arrow-down" /></a>
      {projects.length > 0 && <a href="#projects-heading">Independent project <Icon name="arrow-down" /></a>}
      <a href="#education">Education <Icon name="arrow-down" /></a>
      <a href="#capabilities">Skills <Icon name="arrow-down" /></a>
    </nav>
  </header>

  <div class="container">
    <section aria-labelledby="roles-heading">
      <div class="section-head">
        <h2 id="roles-heading">Roles</h2>
        <p class="label numeric">{String(roles.length).padStart(2, '0')}</p>
      </div>
      <div class="timeline">
        {roles.map((role, index) => <RoleEntry {...role.data} index={index + 1} />)}
      </div>
    </section>

    {
      projects.length > 0 && (
        <section class="group" aria-labelledby="projects-heading">
          <div class="section-head">
            <h2 id="projects-heading">Independent project</h2>
            <p class="label numeric">{String(projects.length).padStart(2, '0')}</p>
          </div>
          <div class="cells stack" data-reveal>
            {projects.map((project) => (
              <article class="row cell cell--link">
                <div class="row__aside">
                  <p class="label numeric">{formatPeriod(project.data.start, project.data.end)}</p>
                  <p class="label">{project.data.kind}</p>
                </div>
                <div>
                  <h3>
                    <a class="stretched" href={projectPath(project)}>
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="row__text">{project.data.summary}</p>
                </div>
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="group" id="education" aria-labelledby="education-heading">
      <div class="section-head">
        <h2 id="education-heading">Education</h2>
        <p class="label numeric">{String(education.length).padStart(2, '0')}</p>
      </div>
      <div class="cells stack" data-reveal>
        {
          education.map(({ data }) => (
            <article class="row cell">
              <div class="row__aside">
                <p class="label numeric">{data.period}</p>
                <p class="label">{data.location}</p>
              </div>
              <div>
                <h3>{data.institution}</h3>
                <p class="row__lead">{data.qualification}</p>
                <dl class="facts">
                  {data.coursework && (
                    <div>
                      <dt class="label">Relevant coursework</dt>
                      <dd>{data.coursework.join(', ')}</dd>
                    </div>
                  )}
                  {data.activities && (
                    <div>
                      <dt class="label">Leadership and activities</dt>
                      <dd>{data.activities.join('; ')}</dd>
                    </div>
                  )}
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="group" id="capabilities" aria-labelledby="capabilities-heading">
      <div class="section-head">
        <div>
          <h2 id="capabilities-heading">Skills</h2>
          <p class="group__intro">Research, writing and leadership, illustrated through my work.</p>
        </div>
        <p class="label numeric">{String(capabilities.length).padStart(2, '0')}</p>
      </div>
      <div class="cells capabilities" data-reveal>
        {
          capabilities.map(({ data }, position) => (
            <article class="capability cell">
              <p class="label numeric capability__index">{String(position + 1).padStart(2, '0')}</p>
              <h3>{data.title}</h3>
              <p class="capability__text">{data.description}</p>
              {data.evidence && (
                <ul aria-label={`Evidence for ${data.title.toLowerCase()}`}>
                  {data.evidence.map((item) => (
                    <li>
                      <a class="arrow-link" href={item.href}>
                        {item.label}
                        <Icon name="arrow-right" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="group" aria-labelledby="also-heading">
      <div class="section-head">
        <h2 id="also-heading">Awards and athletics</h2>
      </div>
      <div class="cells also" data-reveal>
        <div class="cell">
          <p class="label">Awards</p>
          <ul>
            {profile.awards.map((award) => <li>{award}</li>)}
          </ul>
        </div>
        <div class="cell">
          <p class="label">Athletics</p>
          <ul>
            {profile.athletics.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <p class="cv-link">
      For a one-page summary, <a href="/cv/">view my CV</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .experience-header h1 {
    font-family: var(--display, var(--sans));
    font-size: clamp(4.1rem, 13.7vw, 12rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .experience-header__lower { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-5) var(--space-7); margin-top: var(--space-6); }
  .experience-header__lower .lede { margin: 0; max-width: 44rem; }
  .experience-jumps { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; margin-top: var(--space-7); padding-block: 1rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .experience-jumps a { display: inline-flex; align-items: center; gap: 0.75em; padding-block: 0.3rem; font-family: var(--mono); font-size: 0.6875rem; text-transform: uppercase; text-decoration: none; letter-spacing: 0.04em; }
  .experience-jumps a :global(.icon) { transition: transform 350ms var(--ease); }
  .experience-jumps a:hover :global(.icon) { transform: translateY(3px); }
  .timeline { position: relative; margin-top: var(--space-5); }

  .group {
    margin-top: var(--section);
  }

  .group__intro {
    margin-top: var(--space-3);
    color: var(--muted);
  }

  .stack {
    grid-template-columns: minmax(0, 1fr);
  }

  .row {
    display: grid;
    gap: var(--space-4) var(--space-6);
  }

  @media (min-width: 56rem) {
    .row {
      grid-template-columns: 15rem minmax(0, 1fr);
      padding-block: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    }
  }

  .row.cell--link {
    padding-right: 4.5rem;
  }

  .row .go {
    position: absolute;
    top: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
    right: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
  }

  .row__aside {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
  }

  @media (min-width: 56rem) {
    .row__aside {
      flex-direction: column;
      gap: var(--space-2);
      padding-top: 0.5rem;
    }
  }

  .row h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .row h3 a {
    text-decoration: none;
  }

  .row__lead {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    color: var(--ink-2);
  }

  .row__text {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--cell-muted);
    transition: color 0.3s var(--ease);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    max-width: var(--measure);
  }

  .facts dd {
    margin-top: var(--space-1);
    color: var(--ink-2);
  }

  .capabilities {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* An odd one out at the end takes the full width. */
    .capabilities > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .capability {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    min-height: 20rem;
  }

  .capability__index {
    color: var(--accent-text) !important;
    font-family: var(--display, var(--sans));
    font-size: 3.5rem;
    font-weight: 400;
    line-height: 1;
  }

  .capability__text {
    max-width: 34rem;
    color: var(--ink-2);
  }

  .capability ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .also {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .also {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .also ul {
    margin-top: var(--space-3);
  }

  .also li {
    padding-block: 0.55rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  @media (max-width: 55.99rem) {
    .row.cell--link {
      padding-right: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
    }

    .row.cell--link .row__aside {
      min-height: 2.75rem;
      padding-right: 3.75rem;
    }
  }

  @media (pointer: coarse) {
    .experience-jumps a {
      min-height: 2.75rem;
      padding-block: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .capability {
      min-height: 0;
    }
  }

  .cv-link {
    margin-top: var(--space-7);
    color: var(--muted);
  }

  @media print {
    .experience-jumps { display: none; }
    .capability { min-height: 0; }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BarChart from '../../components/BarChart.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import CurveChart from '../../components/CurveChart.astro';
import DataTable from '../../components/DataTable.astro';
import Figure from '../../components/Figure.astro';
import Icon from '../../components/Icon.astro';
import KeyNumbers from '../../components/KeyNumbers.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import ResearchVisual from '../../components/ResearchVisual.astro';
import ViewChangers from '../../components/ViewChangers.astro';
import ViewsRecord from '../../components/ViewsRecord.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatAuthors,
  getProfile,
  getPublicResearch,
  getRelated,
  hasDetailPage,
  researchPath,
  type Research,
} from '../../lib/content';
import { formatDate, formatDateShort } from '../../lib/dates';
import { RESEARCH_TYPES, STATUS_LABELS, TOPICS } from '../../site.config';

// One page per public piece of research. Private entries never reach this list.
export async function getStaticPaths() {
  const all = await getPublicResearch();
  const pages = all.filter(hasDetailPage);
  return pages.map((entry, position) => ({
    params: { slug: entry.id },
    // "Up next" is the piece published before this one; the oldest hands over to the newest.
    props: (() => {
      const next = pages.length > 1 ? pages[(position + 1) % pages.length] : undefined;
      // The piece shown as Up next is not shown again among the related cards just below it.
      return { entry, next, related: getRelated(entry, all).filter((item) => item.id !== next?.id) };
    })(),
  }));
}

interface Props {
  entry: Research;
  related: Research[];
  next?: Research;
}

const { entry, related, next } = Astro.props;
const { data } = entry;
const profile = await getProfile();
const coAuthors = data.authors.filter((author) => author !== profile.name);
const { Content } = await render(entry);
const hasViews = (await getCollection('views')).some((view) => view.data.report === entry.id);
const hasBody = Boolean(entry.body?.trim());
const hasExhibits = Boolean(data.charts?.length || data.tables?.length || data.figures?.length);

const fullPieceLabel = `Read the full ${RESEARCH_TYPES[data.type].toLowerCase()} at ${data.venue.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: data.title,
  description: data.summary,
  mainEntity: {
    '@type': 'Report',
    headline: data.title,
    ...(data.date ? { datePublished: data.date } : {}),
    publisher: { '@type': 'Organization', name: data.venue.name },
    author: data.authors.map((name) => ({ '@type': 'Person', name })),
    ...(data.originalUrl ? { url: data.originalUrl } : {}),
  },
};
---

<BaseLayout title={data.title} description={data.summary} ogType="article" jsonLd={jsonLd}>
  <!-- A thin bar that fills as the page is read. -->
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article>
    <header class="container report-header">
      <a class="arrow-link arrow-link--back" href="/research/" data-research-return>
        <Icon name="arrow-left" />
        All research
      </a>
      <div class="report-header__layout">
      <div class="report-header__copy">
      <p class="label label--marked report-header__kicker">
        {RESEARCH_TYPES[data.type]} · {data.topics.map((topic) => TOPICS[topic]).join(' · ')}
      </p>
      <h1 style={`view-transition-name: research-${entry.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`}>{data.title}</h1>
      {data.subtitle && <p class="report-header__subtitle">{data.subtitle}</p>}
      <p class="lede">{data.standfirst ?? data.summary}</p>
      {coAuthors.length > 0 && (
        <div class="report-header__credits" data-research-credits>
          <p>Co-authored with {formatAuthors(coAuthors)}.</p>
          {data.authorshipNote && <p class="report-header__credit-note">{data.authorshipNote}</p>}
        </div>
      )}
      <div class="report-header__mobile">
        <p class="report-header__byline">
          {data.date && <time datetime={data.date}>{formatDate(data.date)}</time>}
        </p>
        <div class="report-header__actions">
          {data.originalUrl && <ButtonLink href={data.originalUrl} label={fullPieceLabel} icon="arrow-up-right" />}
          {data.pdf && <ButtonLink href={data.pdf} label="Open the PDF" variant="secondary" icon="download" />}
        </div>
        {data.fullReportMinutes && <p class="details__note">Full {RESEARCH_TYPES[data.type].toLowerCase()}: {data.fullReportMinutes}-minute read.</p>}
      </div>
      </div>
      <div class="report-header__visual"><ResearchVisual entry={entry} compact /></div>
      </div>
      <nav class="report-sections side-scroll" aria-label="On this page">
        {hasBody && <a href="#summary-heading">Summary</a>}
        {data.keyFindings.length > 0 && <a href="#findings-heading">Key findings</a>}
        {hasViews && <a href="#views">How the views have held up</a>}
        {data.viewChangers && <a href="#changers-heading">What would change the view</a>}
        {hasExhibits && <a href="#exhibits-heading">From the report</a>}
        {data.approach && <a href="#approach-heading">Data and approach</a>}
        {data.sources && <a href="#sources-heading">Principal sources</a>}
      </nav>
    </header>

    <div class="container report-body">
      <div class="report-main">
        {
          hasBody && (
            <section class="block" aria-labelledby="summary-heading">
              <h2 id="summary-heading" class="block__title label label--marked">
                Summary
              </h2>
              <div class="prose summary">
                <Content />
              </div>
            </section>
          )
        }

        {
          data.keyNumbers && (
            <div class="block">
              <KeyNumbers items={data.keyNumbers} note={data.keyNumbersNote} />
            </div>
          )
        }

        {
          data.keyFindings.length > 0 && (
            <section class="block" aria-labelledby="findings-heading">
              <h2 id="findings-heading" class="block__title label label--marked">
                Key findings
              </h2>
              <ol class="findings">
                {data.keyFindings.map((finding, position) => (
                  <li data-reveal={Math.min(position + 1, 3)}>
                    <span class="findings__index numeric" aria-hidden="true">
                      {String(position + 1).padStart(2, '0')}
                    </span>
                    <p>{finding}</p>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          hasViews && (
            <div class="block">
              <ViewsRecord report={entry.id} heading="How the views have held up" />
            </div>
          )
        }

        {
          data.viewChangers && (
            <section class="block" aria-labelledby="changers-heading">
              <h2 id="changers-heading" class="block__title label label--marked">
                What would change the view
              </h2>
              <ViewChangers items={data.viewChangers} />
            </section>
          )
        }

        {
          hasExhibits && (
            <section class="block" aria-labelledby="exhibits-heading">
              <h2 id="exhibits-heading" class="block__title label label--marked">
                From the report
              </h2>
              <div class="exhibits">
                {data.charts?.map((chart) => (chart.kind === 'futures-curve' ? <CurveChart {...chart} /> : <BarChart {...chart} />))}
                {data.figures?.map((figure) => <Figure {...figure} />)}
                {data.tables?.map((table) => <DataTable {...table} />)}
              </div>
            </section>
          )
        }

        {
          data.approach && (
            <section class="block" aria-labelledby="approach-heading">
              <h2 id="approach-heading" class="block__title label label--marked">
                Data and approach
              </h2>
              <div class="prose">
                <p>{data.approach}</p>
              </div>
            </section>
          )
        }

        {
          data.sources && (
            <section class="block" aria-labelledby="sources-heading">
              <h2 id="sources-heading" class="block__title label label--marked">
                Principal sources
              </h2>
              <ul class="sources">
                {data.sources.map((source) => (
                  <li>
                    {source.url ? (
                      <a href={source.url} rel="noopener">
                        {source.label}
                      </a>
                    ) : (
                      source.label
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="panel panel--night closing" data-reveal>
          <p class="closing__lead">
            {data.originalUrl ? `Read the full ${RESEARCH_TYPES[data.type].toLowerCase()} for the complete analysis.` : 'Research summary.'}
          </p>
          {
            data.originalUrl && (
              <ButtonLink href={data.originalUrl} label={fullPieceLabel} variant="on-dark" icon="arrow-up-right" />
            )
          }
          <p class="closing__note">
            {data.date ? `Dated analysis from ${formatDate(data.date)}. ` : ''}Views and price ranges reflect the information
            available at the time and have not been updated. Nothing here is investment advice.
          </p>
        </div>
      </div>

      <aside class="details" aria-label="About this piece">
        <dl class="cells details__list">
          {
            data.date && (
              <div class="cell">
                <dt class="label">Published</dt>
                <dd>
                  <time datetime={data.date}>{formatDate(data.date)}</time>
                </dd>
              </div>
            )
          }
          {
            data.updated && (
              <div class="cell">
                <dt class="label">Updated</dt>
                <dd>
                  <time datetime={data.updated}>{formatDate(data.updated)}</time>
                </dd>
              </div>
            )
          }
          <div class="cell">
            <dt class="label">Venue</dt>
            <dd>
              {
                data.venue.url ? (
                  <a class="quiet-link" href={data.venue.url} rel="noopener">
                    {data.venue.name}
                  </a>
                ) : (
                  data.venue.name
                )
              }
            </dd>
          </div>
          <div class="cell">
            <dt class="label">Status</dt>
            <dd>{STATUS_LABELS[data.publicationStatus]}</dd>
          </div>
          {
            data.dataAsOf && (
              <div class="cell">
                <dt class="label">Data</dt>
                <dd>{data.dataAsOf}</dd>
              </div>
            )
          }
        </dl>
        <div class="details__actions">
          {data.originalUrl && <ButtonLink href={data.originalUrl} label={fullPieceLabel} icon="arrow-up-right" />}
          {data.pdf && <ButtonLink href={data.pdf} label="Open the PDF" variant="secondary" icon="download" />}
          {
            data.fullReportMinutes && (
              <p class="details__note">Full {RESEARCH_TYPES[data.type].toLowerCase()}: {data.fullReportMinutes}-minute read.</p>
            )
          }
        </div>
      </aside>
    </div>
  </article>

  {
    next && (
      <section class="container upnext" aria-labelledby="upnext-heading" data-reveal data-reveal-style="mask">
        <a class="upnext__band" href={researchPath(next)} data-vt-key={next.id}>
          <span class="upnext__rule" aria-hidden="true" />
          <span class="upnext__label label" id="upnext-heading">
            Up next
          </span>
          <span class="upnext__title" data-vt-title>
            {next.data.title}
          </span>
          <span class="upnext__meta label">
            {next.data.date && <time datetime={next.data.date}>{formatDateShort(next.data.date)}</time>}
            <span>{RESEARCH_TYPES[next.data.type]}</span>
            <span>{TOPICS[next.data.topics[0]!]}</span>
          </span>
          <span class="upnext__go" aria-hidden="true">
            <Icon name="arrow-right" />
          </span>
        </a>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="container related" aria-labelledby="related-heading">
        <div class="section-head">
          <h2 id="related-heading">Related research</h2>
          <a class="arrow-link arrow-link--back" href="/research/" data-research-return>
            <Icon name="arrow-left" />
            Back to all research
          </a>
        </div>
        <div class="cells related__list">
          {related.map((other) => <ResearchCard entry={other} size="compact" />)}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Restore the list context only when it belongs to this report and this origin.
  let listContext: string | undefined;
  try {
    const saved: { list?: unknown; report?: unknown } = JSON.parse(sessionStorage.getItem('research-return') ?? 'null') ?? {};
    if (typeof saved.list === 'string' && saved.report === location.pathname) {
      const url = new URL(saved.list, location.origin);
      if (
        url.origin === location.origin && url.pathname === '/research/' &&
        [...url.searchParams.keys()].every((key) => key === 'topic' || key === 'q')
      ) {
        listContext = url.pathname + url.search;
        for (const anchor of document.querySelectorAll<HTMLAnchorElement>('[data-research-return]')) anchor.href = listContext;
      }
    }
  } catch {}

  // Related pieces keep the same list context without affecting ordinary navigation.
  const rememberRelated = (event: MouseEvent) => {
    if (!listContext) return;
    const anchor = (event.target as Element).closest<HTMLAnchorElement>('.related a[href]');
    if (!anchor) return;
    const url = new URL(anchor.href, location.href);
    if (url.origin !== location.origin || url.pathname === '/research/' || !url.pathname.startsWith('/research/')) return;
    try {
      sessionStorage.setItem('research-return', JSON.stringify({ list: listContext, report: url.pathname }));
    } catch {}
  };
  document.addEventListener('click', rememberRelated);
  document.addEventListener('auxclick', rememberRelated);

  // Reading progress: how far down the page the reader is.
  const bar = document.querySelector<HTMLElement>('[data-progress]');

  if (bar) {
    let ticking = false;
    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${scrollable > 0 ? Math.min(1, window.scrollY / scrollable) : 0})`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .progress {
    position: fixed;
    top: calc(var(--header-height) + 1px);
    left: 0;
    right: 0;
    z-index: 40;
    height: 3px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .report-header {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
  }

  .report-header__kicker {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .report-header__layout { display: grid; min-width: 0; gap: 3rem; }
  .report-header__copy { min-width: 0; }
  .report-header__visual { display: none; min-width: 0; align-self: center; padding-top: 2rem; }
  .report-sections { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .report-sections a { padding: .4rem 0; font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; text-decoration: none; }
  .report-sections a:hover, .report-sections a:focus-visible { color: var(--accent-text); }
  @media (pointer: coarse) { .report-sections a { display: inline-flex; align-items: center; min-height: 2.75rem; padding-block: 0; } }

  .report-header h1 {
    margin-top: var(--space-4);
    max-width: 19ch;
  }

  .report-header__subtitle {
    margin-top: var(--space-4);
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .report-header .lede {
    margin-top: var(--space-5);
  }

  .report-header__credits {
    margin-top: var(--space-4);
    max-width: 46rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .report-header__credit-note {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }

  .report-header__mobile {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .report-header__byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--muted);
  }

  .report-header__byline time {
    font-variant-numeric: tabular-nums;
  }

  .report-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .report-body {
    display: grid;
    gap: var(--space-7);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 64rem) {
    .report-header__layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(2rem, 4vw, 5rem); }
    .report-header__visual { display: block; }
    .report-header h1 { font-size: clamp(2.5rem, 3.5vw, 4rem); line-height: 1.02; }
    .report-header .lede { font-size: clamp(1.1rem, 1.35vw, 1.3rem); }
    .report-header__mobile {
      display: none;
    }

    .report-body {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-8);
      align-items: start;
    }

    .details {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }

    .report-main {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 63.99rem) {
    .details .details__actions {
      display: none;
    }
  }

  /* Details panel */
  .details__list {
    grid-template-columns: minmax(0, 1fr);
  }

  .details__list .cell {
    padding: 0.85rem 1.1rem;
  }

  .details dd {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .details__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .details__note {
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (min-width: 36rem) and (max-width: 63.99rem) {
    .details__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .details__list .cell:first-child {
      grid-column: 1 / -1;
    }

    .details__actions {
      align-items: flex-start;
    }
  }

  /* Main column */
  .report-main {
    min-width: 0;
  }

  .block + .block {
    margin-top: var(--space-7);
  }

  .block__title {
    margin-bottom: var(--space-5);
    color: var(--ink);
    font-weight: 500;
  }

  .summary {
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .findings {
    max-width: 48rem;
    border-top: 1px solid var(--ink);
  }

  .findings li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    /* Lists the reveal's fade here too, because this rule would otherwise replace it. */
    transition:
      padding 0.4s var(--ease),
      opacity 0.7s var(--ease) var(--reveal-delay, 0s),
      transform 0.7s var(--ease) var(--reveal-delay, 0s);
  }

  .findings li:hover {
    padding-left: var(--space-3);
  }

  /* A rail down the findings that fills as they are read, with a node at each one.
     Driven by the scroll position where the browser supports it; otherwise the
     list simply has no rail. Nothing is pinned or delayed. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .findings {
        position: relative;
        padding-left: 1.5rem;
        /* Progress is measured against a narrow band across the middle of the window,
           so the fill's leading edge stays level with what is being read. The rail and
           the nodes are pseudo-elements, which take their timeline from a named one. */
        view-timeline: --findings block;
        view-timeline-inset: 48%;
      }

      .findings::before,
      .findings::after {
        content: '';
        position: absolute;
        left: 0.25rem;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--line);
      }

      .findings::after {
        width: 2px;
        margin-left: -0.5px;
        background: var(--accent);
        transform-origin: center top;
        animation: rail-fill linear both;
      }

      .findings li {
        position: relative;
        view-timeline: --finding block;
        view-timeline-inset: 48%;
        animation: finding-read linear both;
      }

      /* The node beside each finding turns solid as the fill reaches it. */
      .findings li::before {
        content: '';
        position: absolute;
        left: calc(-1.25rem - 3.5px);
        top: calc(var(--space-5) + 0.55rem);
        z-index: 1;
        width: 8px;
        height: 8px;
        border: 1.5px solid var(--muted);
        background: var(--bg);
        animation: node-on linear both;
      }

      .findings li:hover {
        padding-left: 0;
      }
    }
  }

  /* The timelines are set in a block of their own, after the animations. The build
     otherwise folds a timeline into the animation shorthand, which browsers reject,
     and the rail would silently never move. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .findings::after {
        animation-timeline: --findings;
        animation-range: cover 0% cover 100%;
      }

      .findings li {
        animation-timeline: view(block 22% 22%);
        animation-range: cover 0% cover 100%;
      }

      .findings li::before {
        animation-timeline: --finding;
        animation-range: entry 0% entry 30%;
      }
    }
  }

  @keyframes rail-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes finding-read {
    0%,
    100% {
      color: var(--muted);
    }
    22%,
    78% {
      color: var(--ink);
    }
  }

  @keyframes node-on {
    to {
      border-color: var(--accent);
      background: var(--accent);
    }
  }

  .findings__index {
    font-family: var(--mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.9;
    color: var(--accent-text);
  }

  .exhibits {
    display: grid;
    /* minmax(0, 1fr) lets a wide table scroll inside its frame instead of widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    max-width: 50rem;
  }

  .sources {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-2);
    border-top: 1px solid var(--ink);
  }

  .sources li {
    border-bottom: 1px solid var(--line);
  }

  /* A source that is a link is a full-row target; one that is not keeps the same height. */
  .sources li:not(:has(a)) {
    padding-block: 0.65rem;
  }

  .sources a {
    display: block;
    padding-block: 0.65rem;
  }

  .closing {
    display: flex;
    flex-direction: column;

---
import Icon from '../../components/Icon.astro';
import ResearchTape from '../../components/ResearchTape.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicResearch, hasDetailPage, researchPath } from '../../lib/content';
import { formatDateShort } from '../../lib/dates';
import { RESEARCH_TYPES, STATUS_LABELS, TOPICS, type TopicId } from '../../site.config';

const all = await getPublicResearch();
const published = all.filter(hasDetailPage);
const inProgress = all.filter((entry) => !hasDetailPage(entry));

// Only topics that have at least one piece are offered as filters.
const topicIds = (Object.keys(TOPICS) as TopicId[]).filter((id) =>
  published.some((entry) => entry.data.topics.includes(id)),
);

// Search text is stored without accents or curly apostrophes, so "el nino" finds "El Niño".
// The same steps are applied to what the visitor types (see the script below).
const searchable = (text: string) =>
  text
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .replace(/[’‘]/g, "'")
    .toLowerCase();

const description =
  'Research by James Sahota on oil, natural gas and LNG, refined products, shipping chokepoints and energy policy, with a summary of each piece.';
---

<BaseLayout title="Research" description={description}>
  <header class="page-header container">
    <p class="label">
      <span class="label--accent">{String(published.length).padStart(2, '0')}</span> / Reports and briefs
    </p>
    <h1 class="display">Research</h1>
    <p class="lede">
      Reports and briefs on oil, gas, refined products and the routes that carry them. Each has a summary of its question
      and findings, with a link to the full piece.
    </p>
  </header>

  <div class="container">
    {
      inProgress.length > 0 && (
        <section class="panel panel--night in-progress" aria-labelledby="in-progress-heading" data-loop-host>
          <h2 id="in-progress-heading" class="label in-progress__badge">
            <span class="in-progress__dot" aria-hidden="true" data-loop="4" />
            In progress
          </h2>
          <ul>
            {inProgress.map((entry) => (
              <li>
                <p class="in-progress__summary">{entry.data.summary}</p>
                <p class="label">
                  {STATUS_LABELS[entry.data.publicationStatus]} ·{' '}
                  {entry.data.venue.url ? (
                    <a href={entry.data.venue.url} rel="noopener">
                      {entry.data.venue.name}
                    </a>
                  ) : (
                    entry.data.venue.name
                  )}{' '}
                  · {entry.data.topics.map((topic) => TOPICS[topic]).join(', ')}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <ResearchTape entries={published} pending={inProgress} />

    <section class="published" aria-labelledby="published-heading">
      <div class="list-head">
        <h2 id="published-heading">Browse by topic</h2>
        <p class="label numeric" data-count role="status" aria-live="polite">
          {published.length} pieces
        </p>
      </div>

      <!-- The filter controls are switched on by JavaScript. Without it the full list below is shown. -->
      <form class="filters" data-filters hidden role="search" aria-label="Filter research">
        <div class="filters__topics" role="group" aria-label="Topic">
          <button type="button" class="chip" data-topic="" aria-pressed="true">All</button>
          {
            topicIds.map((id) => (
              <button type="button" class="chip" data-topic={id} aria-pressed="false">
                {TOPICS[id]}
                <span class="chip__count numeric">
                  <span class="visually-hidden">, </span>
                  {published.filter((entry) => entry.data.topics.includes(id)).length}
                  <span class="visually-hidden">
                    {published.filter((entry) => entry.data.topics.includes(id)).length === 1 ? ' piece' : ' pieces'}
                  </span>
                </span>
              </button>
            ))
          }
        </div>
        <div class="filters__search">
          <label for="research-search" class="visually-hidden">Search research</label>
          <input
            id="research-search"
            type="search"
            name="q"
            placeholder="Search titles and summaries"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <button type="button" class="filters__reset arrow-link" data-clear hidden>Clear filters</button>
      </form>

      <ol class="cells list" data-list>
        {
          published.map((entry, position) => (
            <li
              class="item cell cell--link"
              data-item
              data-vt-key={entry.id}
              data-reveal={(position % 3) + 1}
              data-topics={entry.data.topics.join(' ')}
              data-search={searchable(
                [
                  entry.data.title,
                  entry.data.summary,
                  entry.data.venue.name,
                  entry.data.topics.map((topic) => TOPICS[topic]).join(' '),
                  RESEARCH_TYPES[entry.data.type],
                ].join(' '),
              )}
            >
              <div class="item__aside">
                {entry.data.date && (
                  <time class="label label--ink numeric" datetime={entry.data.date}>
                    {formatDateShort(entry.data.date)}
                  </time>
                )}
                <p class="label">{RESEARCH_TYPES[entry.data.type]}</p>
                {entry.data.publicationStatus !== 'published' && (
                  <p class="label label--accent">{STATUS_LABELS[entry.data.publicationStatus]}</p>
                )}
              </div>
              <div class="item__main">
                <h3 class="item__title">
                  <a class="stretched" href={researchPath(entry)}>
                    <span class="research-title" data-vt-title>{entry.data.title}</span>
                  </a>
                </h3>
                <p class="item__summary">{entry.data.summary}</p>
                <p class="item__meta label">
                  {[
                    entry.data.venue.name,
                    entry.data.topics.map((topic) => TOPICS[topic]).join(', '),
                  ].join(' · ')}
                </p>
              </div>
              <span class="go" aria-hidden="true">
                <Icon name="arrow-right" />
              </span>
            </li>
          ))
        }
      </ol>

      <div class="empty" data-empty hidden>
        <p>No research matches that search.</p>
        <button type="button" class="btn btn--secondary" data-reset><span>Show all research</span></button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Topic filter and text search. The list is complete in the HTML; this only hides rows.
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const list = document.querySelector<HTMLElement>('[data-list]');

  if (form && count && empty && list) {
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-topic]')];
    const search = form.querySelector<HTMLInputElement>('input[type="search"]')!;
    const clear = form.querySelector<HTMLButtonElement>('[data-clear]')!;
    const params = new URLSearchParams(location.search);
    let topic = chips.some((chip) => chip.dataset.topic === params.get('topic')) ? params.get('topic')! : '';
    search.value = params.get('q') ?? '';

    const apply = (updateUrl = true) => {
      const typed = search.value
        .normalize('NFD')
        .replace(/\p{Diacritic}/gu, '')
        .replace(/[’‘]/g, "'")
        .toLowerCase();
      const words = typed.trim().split(/\s+/).filter(Boolean);
      let shown = 0;

      for (const item of items) {
        const matchesTopic = !topic || item.dataset.topics!.split(' ').includes(topic);
        const matchesText = words.every((word) => item.dataset.search!.includes(word));
        const visible = matchesTopic && matchesText;
        item.hidden = !visible;
        if (visible) shown += 1;
        // The publication record above keeps every piece and empties the ones filtered out.
        document
          .querySelector(`[data-tape-key="${CSS.escape(item.dataset.vtKey ?? '')}"]`)
          ?.classList.toggle('is-out', !visible);
      }

      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.topic === topic));

      const filtered = Boolean(topic || words.length);
      clear.hidden = !filtered;
      count.textContent = filtered ? `Showing ${shown} of ${items.length}` : `${items.length} pieces`;
      empty.hidden = shown > 0;
      list.hidden = shown === 0;

      if (updateUrl) {
        const next = new URLSearchParams();
        if (topic) next.set('topic', topic);
        if (search.value.trim()) next.set('q', search.value.trim());
        const query = next.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
      }
    };

    // Where the browser supports it, the list behaves like a screen being re-sorted:
    // rows that stay slide to their new places, rows that go fade out, the selected
    // block glides to the new topic and the count rolls. Nothing else on the page moves.
    const root = document.documentElement;
    const pressed = () => chips.find((chip) => chip.getAttribute('aria-pressed') === 'true');
    const nameRows = () => {
      items.forEach((item, index) => {
        item.style.viewTransitionName = item.hidden ? '' : `row-${index}`;
      });
    };
    const animate = (change: () => void) => {
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches || root.dataset.motion === 'paused';
      const start = (document as Document & { startViewTransition?: (callback: () => void) => { finished: Promise<void> } })
        .startViewTransition;
      if (still || !start || root.dataset.vt) {
        change();
        return;
      }
      root.dataset.vt = 'filter';
      nameRows();
      count.style.viewTransitionName = 'filter-count';
      const from = pressed();
      if (from) from.style.viewTransitionName = 'filter-chip';
      const transition = start.call(document, () => {
        if (from) from.style.viewTransitionName = '';
        change();
        nameRows();
        const to = pressed();
        if (to) to.style.viewTransitionName = 'filter-chip';
      });
      const settle = () => {
        for (const element of [...items, ...chips, count]) element.style.viewTransitionName = '';
        delete root.dataset.vt;
      };
      // A transition that is skipped (a second click, a hidden tab) rejects; tidy up either way.
      transition.finished.then(settle, settle);
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        topic = chip.dataset.topic ?? '';
        animate(() => apply());
      });
    }

    search.addEventListener('input', () => apply());
    form.addEventListener('submit', (event) => event.preventDefault());

    const reset = () => {
      topic = '';
      search.value = '';
      animate(() => apply());
      search.focus();
    };
    clear.addEventListener('click', reset);
    empty.querySelector('[data-reset]')?.addEventListener('click', reset);

    // Remember the filtered list for this specific report, including modified clicks.
    const rememberList = (event: MouseEvent) => {
      const anchor = (event.target as Element).closest<HTMLAnchorElement>('[data-item] a[href]');
      if (!anchor) return;
      const report = new URL(anchor.href, location.href);
      if (report.origin !== location.origin || !report.pathname.startsWith('/research/')) return;
      try {
        sessionStorage.setItem('research-return', JSON.stringify({
          list: location.pathname + location.search,
          report: report.pathname,
        }));
      } catch {}
    };
    list.addEventListener('click', rememberList);
    list.addEventListener('auxclick', rememberList);

    form.hidden = false;
    apply(false);
  }
</script>

<style>
  /* In progress */
  .in-progress {
    display: grid;
    gap: var(--space-4) var(--space-6);
    padding: clamp(1rem, 0.8rem + 1vw, 1.75rem);
    border-left: 3px solid var(--accent-on-panel);
  }

  @media (min-width: 56rem) {
    .in-progress {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .in-progress__badge {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--panel-ink);
    align-self: start;
    padding-top: 0.5rem;
  }

  .in-progress__dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--accent-on-panel);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  .in-progress__summary {
    max-width: 60rem;
    font-size: var(--text-base);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .in-progress .label:not(.in-progress__badge) {
    margin-top: var(--space-2);
  }

  /* List heading and filters */
  .published {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-5);
  }

  .filters__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    min-height: 2.5rem;
    padding: 0.35rem 1rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--ink) 26%, transparent);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  /* How many pieces a topic holds. */
  .chip__count {
    margin-left: 0.5em;
    color: var(--muted);
    transition: color 0.25s var(--ease);
  }

  .chip[aria-pressed='true'] .chip__count {
    color: color-mix(in srgb, var(--bg) 62%, transparent);
  }

  .filters__search {
    flex: 1 1 15rem;
    max-width: 22rem;
  }

  .filters__search input {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 0.25s var(--ease);
  }

  .filters__search input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .filters__search input:hover,
  .filters__search input:focus-visible {
    border-color: var(--ink);
  }

  .filters__reset {
    min-height: 2.5rem;
    padding-inline: 0;
    color: var(--accent-text);
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* List */
  .list {
    margin-top: var(--space-5);
  }

  .item {
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding-right: 4.5rem;
  }

  @media (min-width: 56rem) {
    .item {
      grid-template-columns: 10.5rem minmax(0, 1fr);
      padding-block: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
    }
  }

  .item .go {
    position: absolute;
    top: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
    right: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
  }

  .item__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
  }

  .item:hover .label--ink,
  .item:focus-within .label--ink {
    color: var(--invert-ink);
  }

  /* The row whose square is being pointed at in the publication record. */
  .item:global(.is-traced) {
    box-shadow: inset 4px 0 0 var(--accent);
  }

  @media (min-width: 56rem) {
    .item__aside {
      flex-direction: column;
      gap: var(--space-2);
      padding-top: 0.5rem;
    }
  }

  .item__title {
    font-size: var(--text-2xl);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 26ch;
  }

  .item__title a {
    text-decoration: none;
  }

  .item__summary {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--cell-muted);
    transition: color 0.3s var(--ease);
  }

  .item__meta {
    margin-top: var(--space-4);
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    margin-top: var(--space-5);
    color: var(--ink-2);
  }
</style>

---
import ButtonLink from '../components/ButtonLink.astro';
import CopyEmail from '../components/CopyEmail.astro';
import FlowPanel from '../components/FlowPanel.astro';
import Icon from '../components/Icon.astro';
import ResearchCard from '../components/ResearchCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getExperience,
  getFeaturedResearch,
  getProfile,
  getPublicProjects,
  getPublicResearch,
  hasDetailPage,
  projectPath,
} from '../lib/content';
import { formatPeriod } from '../lib/dates';

const profile = await getProfile();
const [lead, ...secondary] = await getFeaturedResearch(3);
const researchCount = (await getPublicResearch()).filter(hasDetailPage).length;
const roles = (await getExperience()).filter((role) => role.data.showOnHome);
const project = (await getPublicProjects()).find((entry) => entry.data.featured);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  sameAs: [profile.linkedin],
  description: profile.intro,
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <FlowPanel>
      <h1 class="hero__title">
        <span class="hero__name label">{profile.name}</span>{' '}
        <span class="hero__statement">{profile.positioning}</span>
      </h1>
      <div class="hero__lower">
        <p class="hero__intro">{profile.intro}</p>
        <div class="hero__actions">
          <ButtonLink href="/research/" label="Explore research" variant="on-dark" icon="arrow-right" />
          <ButtonLink href="/cv/" label="View CV" variant="outline-dark" />
        </div>
      </div>
    </FlowPanel>

    <dl class="cells glance container" aria-label="At a glance">
      {
        profile.atAGlance.map((fact) => (
          <div class="cell">
            <dt class="label">{fact.label}</dt>
            <dd>
              {fact.href ? (
                <a class="quiet-link" href={fact.href} rel={fact.href.startsWith('http') ? 'noopener' : undefined}>
                  {fact.value}
                </a>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    lead && (
      <section class="section container" aria-labelledby="research-heading">
        <div class="section-head" data-reveal>
          <div>
            <p class="label">
              <span class="label--accent">01</span> / Research
            </p>
            <h2 id="research-heading">Selected research</h2>
          </div>
          <ButtonLink href="/research/" label={`All ${researchCount} pieces`} variant="secondary" icon="arrow-right" />
        </div>

        <div class="cells selected" data-reveal>
          <ResearchCard entry={lead} self={profile.name} index={1} size="lead" />
          {secondary.map((entry, position) => (
            <ResearchCard entry={entry} self={profile.name} index={position + 2} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section container" aria-labelledby="experience-heading">
    <div class="panel panel--night">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">
            <span class="on-panel-accent">02</span> / Experience
          </p>
          <h2 id="experience-heading">Experience and leadership</h2>
        </div>
        <ButtonLink href="/experience/" label="Full experience" variant="outline-dark" icon="arrow-right" />
      </div>

      <ol class="roles">
        {
          roles.map((role, position) => (
            <li class="roles__item" data-reveal={position + 1}>
              <p class="roles__period label numeric">{formatPeriod(role.data.start, role.data.end)}</p>
              <div class="roles__who">
                <h3>{role.data.organisation}</h3>
                <p class="muted">{role.data.role}</p>
              </div>
              <p class="roles__summary">{role.data.homeSummary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    project && (
      <section class="section container" aria-labelledby="project-heading">
        <div class="panel panel--surface project">
          <div class="project__text" data-reveal>
            <p class="label">
              <span class="label--accent">03</span> / {project.data.kind}
            </p>
            <h2 id="project-heading">{project.data.title}</h2>
            <p class="project__summary">{project.data.summary}</p>
            <ButtonLink href={projectPath(project)} label="Read the case study" icon="arrow-right" />
          </div>
          {project.data.facts && (
            <div class="project__facts" data-reveal="2">
              <dl>
                {project.data.facts.map((fact) => (
                  <div>
                    <dt class="numeric">{fact.value}</dt>
                    <dd>{fact.label}</dd>
                  </div>
                ))}
              </dl>
              {project.data.factsNote && <p class="project__note">{project.data.factsNote}</p>}
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section container" id="contact" aria-labelledby="contact-heading">
    <div class="closing">
      <div class="closing__about" data-reveal>
        <p class="label">
          <span class="label--accent">04</span> / About
        </p>
        <p class="closing__text">{profile.homeAbout}</p>
        <a class="arrow-link" href="/about/">
          More about me
          <Icon name="arrow-right" />
        </a>
      </div>
      <div class="closing__contact" data-reveal="2">
        <p class="label">
          <span class="label--accent">05</span> / Contact
        </p>
        <p class="closing__text">{profile.contactInvite}</p>
      </div>
    </div>

    <h2 id="contact-heading" class="talk" data-reveal>
      <a href={`mailto:${profile.email}`}>
        <span class="talk__words display">Get in touch</span>
        <span class="talk__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
      </a>
    </h2>

    <div class="closing__actions" data-reveal>
      <ButtonLink href={`mailto:${profile.email}`} label={profile.email} icon="mail" />
      <CopyEmail email={profile.email} />
      <ButtonLink href={profile.linkedin} label="LinkedIn" variant="secondary" icon="arrow-up-right" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Introduction */

  .hero__title {
    font-size: inherit;
    letter-spacing: 0;
    line-height: 1;
  }

  .hero__name {
    display: block;
    color: var(--panel-ink);
  }

  .hero__name::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.8em;
    background: var(--accent-on-panel);
  }

  .hero__statement {
    display: block;
    margin-top: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
    font-size: clamp(2.9rem, 1.1rem + 8vw, 8.25rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
    max-width: 9.5ch;
  }

  .hero__lower {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    max-width: 33rem;
  }

  .hero__intro {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: color-mix(in srgb, var(--panel-ink) 86%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .glance {
    margin-top: var(--gutter);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 36rem) {
    .glance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .glance {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .glance dd {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Selected research: one large cell, two beside it */
  .selected {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .selected {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .selected > :global(.rcard--lead) {
      grid-column: 1 / -1;
    }
  }

  /* Experience */
  .on-panel-accent {
    color: var(--accent-on-panel);
  }

  .roles {
    border-top: 1px solid var(--panel-line);
  }

  .roles__item {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--panel-line);
    /* Lists the reveal's fade here too, because this rule would otherwise replace it. */
    transition:
      padding 0.4s var(--ease),
      opacity 0.7s var(--ease) var(--reveal-delay, 0s),
      transform 0.7s var(--ease) var(--reveal-delay, 0s);
  }

  @media (min-width: 56rem) {
    .roles__item {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 6fr);
      align-items: baseline;
      padding-block: var(--space-6);
    }

    .roles__item:hover {
      padding-left: var(--space-4);
    }
  }

  .roles__who h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
    line-height: 1;
    transition: color 0.3s var(--ease);
  }

  .roles__item:hover h3 {
    color: var(--accent-on-panel);
  }

  .roles__who p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .roles__summary {
    max-width: 34rem;
    color: color-mix(in srgb, var(--panel-ink) 84%, transparent);
  }

  /* Project */
  .project {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 62rem) {
    .project {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-8);
      align-items: end;
    }
  }

  .project__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .project__summary {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* One grid for all rows, so the labels line up whatever the width of the figures. */
  .project__facts dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .project__facts dl > div {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    row-gap: var(--space-2);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 34rem) {
    .project__facts dl,
    .project__facts dl > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .project__facts dt {
    font-size: var(--text-2xl);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .project__facts dd {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--muted);
  }

  .project__note {
    margin-top: var(--space-3);
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--muted);
  }

  /* About and contact */
  .closing {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 56rem) {
    .closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  .closing__text {
    margin-block: var(--space-4) var(--space-3);
    max-width: 34rem;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .talk {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .talk a {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(1.25rem, 0.6rem + 3vw, 3rem) 0;
    text-decoration: none;
    transition:
      padding 0.5s var(--ease),
      color 0.35s var(--ease);
  }

  /* The row fills with the accent, from the bottom up. */
  .talk a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: center bottom;
    transition: transform 0.5s var(--ease);
  }

  .talk a:hover,
  .talk a:focus-visible {
    padding-inline: clamp(1rem, 0.4rem + 2.6vw, 3rem);
    color: var(--on-accent);
  }

  .talk a:hover::before,
  .talk a:focus-visible::before {
    transform: scaleY(1);
  }

  .talk__words {
    padding-bottom: 0.08em;
  }

  .talk__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(3rem, 1.5rem + 7vw, 8rem);
    height: clamp(3rem, 1.5rem + 7vw, 8rem);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    font-size: clamp(1.25rem, 0.6rem + 3vw, 3.25rem);
    transition:
      transform 0.5s var(--ease),
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .talk a:hover .talk__arrow,
  .talk a:focus-visible .talk__arrow {
    transform: rotate(45deg);
    background: #101214;
    color: #eef0f1;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>

---
import ButtonLink from '../components/ButtonLink.astro';
import FlowPanel from '../components/FlowPanel.astro';
import LookingFor from '../components/LookingFor.astro';
import Icon from '../components/Icon.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ProjectFlow from '../components/ProjectFlow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getExperience,
  getFeaturedResearch,
  getProfile,
  getPublicProjects,
  getPublicResearch,
  hasDetailPage,
  projectPath,
} from '../lib/content';
import { formatPeriod } from '../lib/dates';

const profile = await getProfile();
const selected = await getFeaturedResearch(4);
const researchCount = (await getPublicResearch()).filter(hasDetailPage).length;
const roles = (await getExperience()).filter((role) => role.data.showOnHome);
const project = (await getPublicProjects()).find((entry) => entry.data.featured);
const headlineLines = profile.positioning.split(/(?=energy and)/);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  sameAs: [profile.linkedin],
  description: profile.intro,
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <FlowPanel>
      <h1 class="hero__title">
        <span class="hero__name label">{profile.name}</span>{' '}
        <span class="hero__statement">
          {headlineLines.map((line, index) => (
            <span class="hero__line"><span class="hero__line-text" style={`--line-order:${index}`}>{line.trim()}{index < headlineLines.length - 1 ? ' ' : ''}</span></span>
          ))}
        </span>
      </h1>
      <div class="hero__lower">
        <p class="hero__intro">{profile.intro}</p>
        <div class="hero__actions">
          <ButtonLink href="/research/" label="Explore research" variant="on-dark" icon="arrow-right" />
          <ButtonLink href="/cv/" label="View CV" variant="outline-dark" />
        </div>
      </div>
    </FlowPanel>
    <div class="route-bridge container" aria-hidden="true"><svg viewBox="0 0 1200 104" preserveAspectRatio="none" fill="none"><path d="M580 0V25Q580 52 540 52H120Q80 52 80 80V104"/><path d="M600 0V104"/><path d="M620 0V25Q620 52 660 52H1080Q1120 52 1120 80V104"/></svg></div>
    <dl class="cells glance container" aria-label="At a glance" data-reveal>
      {
        profile.atAGlance.map((fact) => (
          <div class="cell">
            <dt class="label">{fact.label}</dt>
            <dd>
              {fact.href ? (
                <a class="quiet-link" href={fact.href} rel={fact.href.startsWith('http') ? 'noopener' : undefined}>
                  {fact.value}
                </a>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    selected.length > 0 && (
      <section class="section container selected-section" aria-labelledby="research-heading">
        <div class="section-head" data-reveal>
          <div>
            <p class="label">
              <span class="label--accent">01</span> / Research
            </p>
            <h2 id="research-heading">Selected research</h2>
          </div>
          <ButtonLink href="/research/" label={`All ${researchCount} pieces`} variant="secondary" icon="arrow-right" />
        </div>

        <div class="cells selected" data-carousel>
          {selected.map((entry, position) => (
            <ResearchCard entry={entry} index={position + 1} />
          ))}
        </div>
        <p class="selected__count label numeric" aria-hidden="true" data-carousel-count hidden>
          <span data-carousel-now>1</span> / {selected.length}
          <span class="selected__hint">Swipe for more</span>
        </p>
      </section>
    )
  }

  {
    project && (
      <section class="section container" aria-labelledby="project-heading">
        <div class="panel panel--surface project">
          <div class="project__text" data-reveal>
            <p class="label">
              <span class="label--accent">02</span> / {project.data.kind}
            </p>
            <h2 id="project-heading"><span style={`view-transition-name: project-title-${project.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`}>{project.data.title}</span></h2>
            <p class="project__summary">{project.data.summary}</p>
            <ButtonLink href={projectPath(project)} label="Read the case study" icon="arrow-right" />
          </div>
          <div class="project__system">
            <ProjectFlow compact />
          {project.data.facts && (
            <div class="project__facts" data-reveal="2">
              <dl>
                {project.data.facts.map((fact, position) => (
                  <div style={`--i:${position}`}>
                    <dt class="numeric"><span>{fact.value}</span></dt>
                    <dd>{fact.label}</dd>
                  </div>
                ))}
              </dl>
              {project.data.factsNote && <p class="project__note">{project.data.factsNote}</p>}
            </div>
          )}
          </div>
        </div>
      </section>
    )
  }

  <section class="section container" aria-labelledby="experience-heading" data-reveal data-reveal-style="mask">
    <div class="panel panel--night home-experience">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">
            <span class="on-panel-accent">03</span> / Experience
          </p>
          <h2 id="experience-heading">Experience and leadership</h2>
        </div>
        <ButtonLink href="/experience/" label="Full experience" variant="outline-dark" icon="arrow-right" />
      </div>

      <ol class="roles">
        {
          roles.map((role, position) => (
            <li class="roles__item" data-reveal={position + 1}>
              <span class="roles__index numeric" aria-hidden="true">{String(position + 1).padStart(2, '0')}</span>
              <p class="roles__period label numeric">{formatPeriod(role.data.start, role.data.end)}</p>
              <div class="roles__who">
                <h3>{role.data.organisation}</h3>
                <p class="muted">{role.data.role}</p>
              </div>
              <p class="roles__summary">{role.data.homeSummary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section container home-about" aria-label="About James Sahota">
      <div class="closing__about" data-reveal>
        <p class="label">
          <span class="label--accent">04</span> / About
        </p>
        <p class="closing__text">{profile.homeAbout}</p>
        <a class="arrow-link" href="/about/">
          More about me
          <Icon name="arrow-right" />
        </a>
      </div>
      <LookingFor />
  </section>
</BaseLayout>

<script>
  // The phone carousel of selected research: shows which card is in view.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const counter = document.querySelector<HTMLElement>('[data-carousel-count]');
  const now = counter?.querySelector<HTMLElement>('[data-carousel-now]');
  if (carousel && counter && now) {
    const cards = [...carousel.children] as HTMLElement[];
    const hint = counter.querySelector<HTMLElement>('.selected__hint');
    const phone = window.matchMedia('(max-width: 47.99rem)');
    let live: HTMLElement | undefined;
    // The row is as tall as the card in view, so a short card leaves no gap below it.
    const fit = () => {
      carousel.style.height = phone.matches && live ? `${live.offsetHeight}px` : '';
    };
    counter.hidden = false;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('is-live', entry.isIntersecting);
          if (!entry.isIntersecting) continue;
          live = entry.target as HTMLElement;
          const index = cards.indexOf(live);
          now.textContent = String(index + 1);
          if (hint) hint.hidden = index === cards.length - 1;
          fit();
        }
      },
      { root: carousel, threshold: 0.6 },
    );
    cards.forEach((card) => observer.observe(card));
    phone.addEventListener('change', fit);
    window.addEventListener('resize', fit, { passive: true });
  }
</script>

<style>
  /* Introduction */
  .hero__title {
    font-size: inherit;
    letter-spacing: 0;
    line-height: 1;
  }

  .hero__name {
    display: block;
    color: var(--panel-ink);
    animation: hero-detail-in 0.8s var(--ease-out) 0.12s both;
  }

  .hero__name::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.8em;
    background: var(--accent-on-panel);
  }

  .hero__statement {
    display: block;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    font-size: clamp(3.05rem, 1.1rem + 6.65vw, 8rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.06em;
    max-width: 16ch;
  }

  .hero__line {
    display: block;
    overflow: clip;
    padding-right: 0.1em;
    margin-right: -0.1em;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .hero__line-text {
    display: block;
    animation: hero-line-in 1.15s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--line-order) * 0.14s);
    transform-origin: left bottom;
  }

  .hero__lower {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(1.75rem, 1.1rem + 1.5vw, 2.5rem);
    max-width: 38rem;
  }

  .hero__intro {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: color-mix(in srgb, var(--panel-ink) 86%, transparent);
    animation: hero-detail-in 1s var(--ease-out) 0.55s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    animation: hero-detail-in 1s var(--ease-out) 0.7s both;
  }

  @keyframes hero-line-in {
    from { transform: translateY(112%) rotate(2deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @keyframes hero-detail-in {
    from { transform: translateY(1.1rem); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @media (max-width: 47.99rem) {
    .hero__statement { max-width: 12ch; }
    .hero__line { overflow: hidden; }
    .hero__intro { font-size: 1.0625rem; line-height: 1.55; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__name, .hero__line-text, .hero__intro, .hero__actions { animation: none; }
  }

  .route-bridge { height:6.5rem; overflow:hidden; }
  /* On a phone the facts are stacked, so lines fanning out to three columns point at nothing. */
  @media(max-width:51.99rem) { .route-bridge { display:none; } .glance { margin-top:var(--gutter) !important; } }
  .route-bridge svg { width:100%; height:100%; stroke:var(--accent); stroke-width:1; }
  @media(min-width:52rem) { .glance { margin-top:0 !important; } }
  :global([data-theme='dark']) .home-experience { box-shadow: inset 0 0 0 1px var(--line); }
  .selected-section { padding-top:clamp(4rem,7vw,7rem); }
  .home-experience { position:relative; overflow:hidden; padding:clamp(1.5rem,5vw,4.5rem); background:radial-gradient(ellipse at 100% 100%,#3c251d,transparent 70%),#111719; }
  .roles__index { font-family:var(--display); font-size:3rem; color:#ff6a33; line-height:1; }
  .project__system { min-width:0; display:grid; gap:2rem; }
  .project__text h2 { font-family:var(--display); font-size:clamp(2.5rem,4.5vw,4.8rem); font-weight:400; line-height:1.05; text-transform:uppercase; letter-spacing:-.02em; }
  .project__text h2 span { display:block; }
  .home-about { display:grid; align-items:center; gap:clamp(2rem,5vw,5rem); }
  .home-about .closing__text { max-width:42rem; font-size:clamp(1.6rem,2.8vw,2.8rem); line-height:1.2; }
  @media(min-width:56rem) { .home-about { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(min-width:56rem) { .roles__item { grid-template-columns:3rem minmax(8rem,2fr) minmax(0,4fr) minmax(0,5fr) !important; } }
  @media(max-width:47.99rem) {
    .roles__index { font-size:2.5rem; }
  }
  /* The project's figures land whole, one after another, like the key numbers in a report. */
  .project__facts dt { overflow:clip; }
  .project__facts dt span { display:block; padding-bottom:.06em; }
  .project__facts:global(.reveal-wait) dt span { transform:translateY(115%); }
  .project__facts:global(.reveal-in) dt span { transform:none; transition:transform .9s var(--ease-out) calc(.2s + var(--i)*110ms); }
  .project__facts:global(.reveal-wait) dd { opacity:0; }
  .project__facts:global(.reveal-in) dd { opacity:1; transition:opacity .6s var(--ease) calc(.5s + var(--i)*110ms); }
  @media print { .project__facts dt span { transform:none !important; } .project__facts dd { opacity:1 !important; } }

  .glance {
    margin-top: var(--gutter);
    grid-template-columns: minmax(0, 1fr);
  }

  /* Three facts, side by side once there is room for them. */
  @media (min-width: 52rem) {
    .glance {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .glance dd {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Selected research: four cells, two by two. On a phone, one card at a time in a
     row that is swiped sideways, with the next card peeking in from the right. */
  .selected {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 47.99rem) {
    .selected {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      border: 0;
      border-radius: 0;
    }

    .selected::-webkit-scrollbar {
      display: none;
    }

    /* The row takes the height of the card in view (set by the script), so a short card
       leaves no gap above the counter. */
    .selected {
      overflow-y: hidden;
      transition: height 0.4s var(--ease-out);
    }

    /* Each card keeps its own height, so a short summary leaves no gap inside the card. */
    .selected {
      align-items: flex-start;
    }

    .selected > :global(.rcard) {
      flex: 0 0 min(86%, 24rem);
      scroll-snap-align: start;
      outline: 0;
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }

    /* Here the card in view is the live one, set by the script below as cards are swiped,
       in place of the scroll-linked version used elsewhere (all four share one row). */
    .selected > :global(.rcard)::before,
    .selected > :global(.rcard) :global(.go) {
      animation: none;
    }

    .selected > :global(.rcard.is-live)::before {
      transform: scaleX(1);
    }

    .selected > :global(.rcard.is-live) :global(.go) {
      transform: rotate(-45deg);
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }

    .selected__count {
      display: flex;
      gap: 0.6em;
      margin-top: var(--space-4);
    }

    .selected__count[hidden] {
      display: none;
    }

    .selected__hint {
      margin-left: auto;
    }
  }

  @media (min-width: 48rem) {
    .selected__count {
      display: none !important;
    }

    .selected {
      height: auto !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selected {
      transition: none;
    }
  }

  @media (min-width: 48rem) {
    .selected {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Experience */
  .on-panel-accent {
    color: var(--accent-on-panel);
  }

  .roles {
    border-top: 1px solid var(--panel-line);
  }

  .roles__item {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--panel-line);
    /* Lists the reveal's fade here too, because this rule would otherwise replace it. */
    transition:
      padding 0.4s var(--ease),
      opacity 0.7s var(--ease) var(--reveal-delay, 0s),
      transform 0.7s var(--ease) var(--reveal-delay, 0s);
  }

  @media (min-width: 56rem) {
    .roles__item {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 6fr);
      align-items: baseline;
      padding-block: var(--space-6);
    }

    .roles__item:hover {
      padding-left: var(--space-4);
    }
  }

  .roles__who h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
    line-height: 1;
    transition: color 0.3s var(--ease);
  }

  .roles__item:hover h3 {
    color: var(--accent-on-panel);
  }

  .roles__who p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .roles__summary {
    max-width: 34rem;
    color: color-mix(in srgb, var(--panel-ink) 84%, transparent);
  }

  /* Project */
  .project {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 62rem) {
    .project {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-8);
      align-items: end;
    }
  }

  .project__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .project__summary {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* One grid for all rows, so the labels line up whatever the width of the figures. */
  .project__facts dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .project__facts dl > div {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    row-gap: var(--space-2);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 34rem) {
    .project__facts dl,
    .project__facts dl > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .project__facts dt {
    font-size: var(--text-2xl);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .project__facts dd {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--muted);
  }

  .project__note {
    margin-top: var(--space-3);
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--muted);
  }

  /* About and contact */
  .closing {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 56rem) {
    .closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  .closing__text {
    margin-block: var(--space-4) var(--space-3);
    max-width: 34rem;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .talk {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .talk a {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(1.25rem, 0.6rem + 3vw, 3rem) 0;
    text-decoration: none;
    transition:
      padding 0.5s var(--ease),
      color 0.35s var(--ease);
  }

  /* The row fills with the accent, from the bottom up. */
  .talk a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: center bottom;
    transition: transform 0.5s var(--ease);
  }

  .talk a:hover,
  .talk a:focus-visible {
    padding-inline: clamp(1rem, 0.4rem + 2.6vw, 3rem);
    color: var(--on-accent);
  }

  .talk a:hover::before,
  .talk a:focus-visible::before {
    transform: scaleY(1);
  }

  .talk__words {
    padding-bottom: 0.08em;
  }

  .talk__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(3rem, 1.5rem + 7vw, 8rem);
    height: clamp(3rem, 1.5rem + 7vw, 8rem);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    font-size: clamp(1.25rem, 0.6rem + 3vw, 3.25rem);
    transition:
      transform 0.5s var(--ease),
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .talk a:hover .talk__arrow,
  .talk a:focus-visible .talk__arrow {
    transform: rotate(45deg);
    background: #101214;
    color: #eef0f1;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>

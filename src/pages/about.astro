---
import { render } from 'astro:content';
import ButtonLink from '../components/ButtonLink.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbout, getProfile } from '../lib/content';

const about = await getAbout();
const profile = await getProfile();
const { Content } = await render(about);
const { data } = about;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: Astro.site?.href,
    sameAs: [profile.linkedin],
  },
};
---

<BaseLayout title={data.title} description={data.description} jsonLd={jsonLd}>
  <header class="page-header container about-header">
    <p class="label label--marked">About</p>
    <h1 class="display">{profile.name}</h1>
    <div class="about-header__grid">
      <p class="lede">{data.lede}</p>
      <figure class="about-route" aria-label="Milan, London, Singapore and Chicago" data-loop-host>
        <svg viewBox="0 0 720 230" width="720" height="230" fill="none" aria-hidden="true" focusable="false">
          <g class="about-route__grid">
            <ellipse cx="360" cy="115" rx="295" ry="90" />
            <ellipse cx="360" cy="115" rx="210" ry="90" />
            <ellipse cx="360" cy="115" rx="105" ry="90" />
            <path d="M65 115H655M90 78H630M90 152H630M360 25V205" />
          </g>
          <path class="about-route__track" d="M87 133C127 133 135 60 245 60S337 179 465 179S575 87 633 87" />
          <path class="about-route__signal" data-loop="2" pathLength="1000" d="M87 133C127 133 135 60 245 60S337 179 465 179S575 87 633 87" />
          {[[87, 133], [245, 60], [465, 179], [633, 87]].map(([x, y], index) => (
            <g class="about-route__node" style={`--node:${index}`}>
              <circle cx={x} cy={y} r="16" class="about-route__halo" />
              <circle cx={x} cy={y} r="5" />
              <path d={`M${x - 25} ${y}H${x - 20}M${x + 20} ${y}H${x + 25}M${x} ${y - 25}V${y - 20}M${x} ${y + 20}V${y + 25}`} />
            </g>
          ))}
        </svg>
        <figcaption><ol>{['Milan', 'London', 'Singapore', 'Chicago'].map((city, index) => <li><span aria-hidden="true">0{index + 1}</span>{city}</li>)}</ol></figcaption>
      </figure>
    </div>
  </header>

  <div class="container about">
    <section class="about__bio" id="biography" aria-label="Biography">
      <div class="prose">
        <Content />
      </div>
    </section>

    <aside class="about__aside" aria-label="Contact and links">
      <dl class="cells about__facts">
        <div class="cell">
          <dt class="label">Based in</dt>
          <dd>{profile.location}</dd>
        </div>
        <div class="cell">
          <dt class="label">Languages</dt>
          <dd>
            {profile.languages.map((language) => `${language.name} (${language.level.toLowerCase()})`).join(', ')}
          </dd>
        </div>
        <div class="cell">
          <dt class="label">Email</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
      </dl>
      <div class="about__actions">
        <ButtonLink href={profile.linkedin} label="LinkedIn" variant="secondary" icon="arrow-up-right" />
        <ButtonLink href="/cv/" label="View CV" variant="secondary" icon="arrow-right" />
      </div>
    </aside>
  </div>

  <section class="container group" aria-labelledby="approach-heading">
    <div class="section-head">
      <h2 id="approach-heading">How I approach research</h2>
      <p class="label numeric">{String(data.approach.length).padStart(2, '0')}</p>
    </div>
    <p class="approach__context">Examples from my September 2026 report on the oil supply shock.</p>
    <ol class="cells approach" data-reveal>
      {
        data.approach.map((point, position) => (
          <li class="cell approach__item" data-reveal={position + 1}>
            <p class="label numeric approach__index">{String(position + 1).padStart(2, '0')}</p>
            <h3>{point.title}</h3>
            <p class="approach__text">{point.text}</p>
            {point.example && (
              <a class="arrow-link" href={point.example.href}>
                {point.example.label}
                <Icon name="arrow-right" />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container group" aria-labelledby="beyond-heading">
    <div class="section-head">
      <h2 id="beyond-heading">Beyond work</h2>
    </div>
    <div class="beyond" data-reveal>
      {data.beyondWork.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--ink);
  }

  .about-header h1 {
    font-family: var(--display, var(--sans));
    font-size: clamp(4.5rem, 14vw, 13rem);
    line-height: 0.98;
    font-weight: 400;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .about-header__grid { display: grid; gap: var(--space-6); margin-top: var(--space-7); align-items: center; }
  .about-header__grid .lede { margin: 0; max-width: 27ch; font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.4rem); }

  .about-route { overflow: hidden; background: #111518; border: 1px solid #353c42; border-radius: var(--radius); color: #eef0f1; }
  .about-route svg { display: block; width: 100%; height: auto; background: radial-gradient(ellipse at 65% 50%, #ff6a3317, transparent 65%); }
  .about-route__grid { stroke: #7b8993; opacity: 0.2; stroke-width: 1; }
  .about-route__track { stroke: #667580; stroke-width: 1.5; }
  .about-route__signal { stroke: #ff7e49; stroke-width: 2.5; stroke-dasharray: 90 1000; animation: route-travel 9s linear infinite; animation-play-state: paused; filter: drop-shadow(0 0 7px #ff6a33); }
  :global(.has-nav-toggle) .about-route__signal { animation-play-state: running; }
  .about-route__node { fill: #ff7e49; stroke: #ff7e49; stroke-width: 1; }
  .about-route__halo { fill: #171d21; stroke: #6d7e89; }
  .about-route figcaption { border-top: 1px solid #353c42; padding: 1rem; }
  .about-route ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .about-route li { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8125rem; letter-spacing: -0.025em; }
  .about-route li span { font-family: var(--mono); font-size: 0.625rem; color: #ff8a5c; }

  @keyframes route-travel { to { stroke-dashoffset: -1000; } }

  @media (min-width: 60rem) {
    .about-header__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--space-8); }
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: var(--space-8);
      align-items: start;
    }

    .about__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }

  .about__bio .prose {
    font-size: var(--text-lg);
    line-height: 1.62;
  }

  .about__bio .prose > p:first-child {
    font-size: var(--text-xl);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .about__bio { scroll-margin-top: calc(var(--header-height) + 2rem); }
  .about__bio .prose { max-width: 43rem; }

  .about__facts {
    grid-template-columns: minmax(0, 1fr);
  }

  .about__facts .cell {
    padding: 0.9rem 1.1rem;
  }

  .about__facts dd {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .group {
    margin-top: var(--section);
  }

  .approach {
    grid-template-columns: minmax(0, 1fr);
  }

  .approach__context {
    margin-bottom: var(--space-5);
    color: var(--ink-2);
  }

  @media (min-width: 48rem) {
    .approach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .approach__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    transition: background-color 500ms var(--ease-out, ease), color 500ms var(--ease-out, ease);
  }

  .approach__item:hover { background: var(--panel); color: var(--panel-ink); }
  .approach__item:hover .approach__text { color: #c3cbd0; }
  .approach__item h3 { max-width: 20ch; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }

  .approach__index {
    color: var(--accent-text) !important;
    font-family: var(--display, var(--sans));
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .approach__text {
    max-width: 32rem;
    color: var(--ink-2);
  }

  .approach__item .arrow-link {
    margin-top: auto;
  }

  .beyond {
    display: grid;
    gap: var(--space-5) var(--space-8);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink-2);
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
  }

  @media (min-width: 56rem) {
    .beyond {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-route__signal { animation: none; stroke-dasharray: none; opacity: 0.7; }
  }

  @media print {
    .about-route { display: none; }
  }
</style>

---
import { render } from 'astro:content';
import ButtonLink from '../../components/ButtonLink.astro';
import Figure from '../../components/Figure.astro';
import Icon from '../../components/Icon.astro';
import InvestmentBridge from '../../components/InvestmentBridge.astro';
import KeyNumbers from '../../components/KeyNumbers.astro';
import ProjectDevelopment from '../../components/ProjectDevelopment.astro';
import ProjectFlow from '../../components/ProjectFlow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicProjects, type Project } from '../../lib/content';
import { formatPeriod } from '../../lib/dates';

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Project;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={data.title} description={data.summary} ogType="article">
  <article>
    <header class="container page-header project-header">
      <a class="arrow-link arrow-link--back" href="/projects/">
        <Icon name="arrow-left" />
        All projects
      </a>
      <p class="label label--marked kicker">
        {data.kind} · {formatPeriod(data.start, data.end)}
      </p>
      {data.investmentCase && <p class="project-prepared">Prepared for {data.investmentCase.preparedFor}</p>}
      <h1 style={`view-transition-name: project-title-${entry.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`}>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      {data.investmentCase && (
        <div class="project-actions">
          <ButtonLink href={data.investmentCase.pdf} label="View pitch (PDF)" icon="arrow-up-right" />
          <ButtonLink href={data.investmentCase.slides} label="Download slides" variant="secondary" icon="download" download />
          {data.investmentCase.workbook && <ButtonLink href={data.investmentCase.workbook} label="Download model (Excel)" variant="secondary" icon="download" download />}
        </div>
      )}
      {data.investmentCase?.workbook && <p class="project-model-note">Bull and Bear cases use clearly flagged, reconstructed assumptions.</p>}
      {sections.length > 0 && (
        <nav class="project-jumps side-scroll" aria-label="Jump to project section">
          {sections.map((section) => (
            <a class="arrow-link" href={`#${section.slug}`}>{section.text}<Icon name="arrow-down" /></a>
          ))}
        </nav>
      )}
    </header>

    <div class="container">
      {data.development ? (
        <div class="project-scene"><ProjectDevelopment stages={data.development} /></div>
      ) : !data.investmentCase && <div class="project-scene" data-reveal><ProjectFlow /></div>}
      {data.facts && <KeyNumbers items={data.facts} note={data.factsNote} heading={data.investmentCase ? 'Proposed investment and modelled returns' : 'Project scope'} />}
      {data.investmentCase && <div class="investment-scene"><InvestmentBridge items={data.investmentCase.ebitdaBridge} /></div>}
      {data.figures?.map((figure) => <Figure {...figure} />)}

      <div class:list={['body', { 'body--with-contents': sections.length > 1 }]}>
        {
          sections.length > 1 && (
            <nav class="contents" aria-label="On this page">
              <p class="label">On this page</p>
              <ol>
                {sections.map((section, position) => (
                  <li>
                    <a class="quiet-link" href={`#${section.slug}`}>
                      <span class="numeric contents__index" aria-hidden="true">
                        {String(position + 1).padStart(2, '0')}
                      </span>
                      {section.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="prose case">
          <Content />
        </div>
      </div>

      <a class="arrow-link arrow-link--back back" href="/projects/">
        <Icon name="arrow-left" />
        Back to projects
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .kicker {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .page-header h1 {
    max-width: 18ch;
    font-family: var(--display, var(--sans));
    font-size: clamp(3rem, 6.8vw, 6rem);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .project-header .lede { max-width: 47rem; }
  .project-prepared { margin-top: var(--space-3); color: var(--muted); font-size: var(--text-sm); }
  .project-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .project-model-note { margin-top: var(--space-3); color: var(--muted); font-size: var(--text-sm); }
  .investment-scene { margin-top: var(--space-7); }
  .project-jumps { display: flex; flex-wrap: wrap; gap: 0.2rem 1.5rem; margin-top: var(--space-5); }
  .project-jumps .arrow-link { font-size: 0.6875rem; }
  .project-scene { margin-bottom: var(--space-7); }

  .body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 64rem) {
    .body--with-contents {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }

    .contents {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
      padding: var(--space-5);
      background: var(--surface);
      border: 1px solid var(--line);
      border-top: 3px solid var(--accent);
    }
  }

  /* Below the two-column layout the sideways row of section links does this job. */
  @media (max-width: 63.99rem) {
    .contents {
      display: none;
    }
  }

  .contents ol {
    margin-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .contents li {
    border-bottom: 1px solid var(--line);
  }

  .contents a {
    display: flex;
    gap: var(--space-3);
    padding-block: 0.6rem;
    font-size: var(--text-sm);
  }

  .contents__index {
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.9;
    color: var(--accent-text);
  }

  .case :global(h2) {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
  }

  .case :global(h2:first-child) {
    margin-top: 0;
  }

  .case :global(.sample-output) {
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
    margin-block: var(--space-6);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: var(--surface);
  }

  .case :global(.sample-output__meta) {
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--text-sm);
  }

  .case :global(.sample-output h3) {
    margin-top: var(--space-3);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .case :global(.sample-output__description) {
    margin-top: var(--space-3);
    font-size: var(--text-base);
  }

  .case :global(.sample-output__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .case :global(table) { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm); }
  .case :global(th), .case :global(td) { padding: .75rem .4rem; border-bottom: 1px solid var(--line); }
  .case :global(th:first-child), .case :global(td:first-child) { width: 36%; text-align: left; }
  .case :global(th) { font-weight: 550; }

  .back {
    margin-top: var(--space-7);
  }

  @media print {
    .project-jumps { display: none; }
  }
</style>

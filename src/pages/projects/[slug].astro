---
import { render } from 'astro:content';
import Figure from '../../components/Figure.astro';
import Icon from '../../components/Icon.astro';
import KeyNumbers from '../../components/KeyNumbers.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicProjects, type Project } from '../../lib/content';
import { formatPeriod } from '../../lib/dates';

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Project;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={data.title} description={data.summary} ogType="article">
  <article>
    <header class="container page-header">
      <a class="arrow-link arrow-link--back" href="/experience/">
        <Icon name="arrow-left" />
        Experience
      </a>
      <p class="label label--marked kicker">
        {data.kind} · {formatPeriod(data.start, data.end)}
      </p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
    </header>

    <div class="container">
      {data.facts && <KeyNumbers items={data.facts} note={data.factsNote} heading="Project figures" />}
      {data.figures?.map((figure) => <Figure {...figure} />)}

      <div class:list={['body', { 'body--with-contents': sections.length > 1 }]}>
        {
          sections.length > 1 && (
            <nav class="contents" aria-label="On this page">
              <p class="label">On this page</p>
              <ol>
                {sections.map((section, position) => (
                  <li>
                    <a class="quiet-link" href={`#${section.slug}`}>
                      <span class="numeric contents__index" aria-hidden="true">
                        {String(position + 1).padStart(2, '0')}
                      </span>
                      {section.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="prose case">
          <Content />
        </div>
      </div>

      <a class="arrow-link arrow-link--back back" href="/experience/">
        <Icon name="arrow-left" />
        Back to experience
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .kicker {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .page-header h1 {
    max-width: 18ch;
  }

  .body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 64rem) {
    .body--with-contents {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }

    .contents {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }

  .contents ol {
    margin-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .contents li {
    border-bottom: 1px solid var(--line);
  }

  .contents a {
    display: flex;
    gap: var(--space-3);
    padding-block: 0.6rem;
    font-size: var(--text-sm);
  }

  .contents__index {
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.9;
    color: var(--accent-text);
  }

  .case :global(h2) {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
  }

  .case :global(h2:first-child) {
    margin-top: 0;
  }

  .back {
    margin-top: var(--space-7);
  }
</style>

---
// A research entry as one cell of a ruled grid. The whole cell is the link,
// and it inverts when hovered. Shows a small chart or two figures from the
// report when the entry has them.
import { researchPath, type Research } from '../lib/content';
import { formatDateShort } from '../lib/dates';
import { RESEARCH_TYPES, TOPICS } from '../site.config';
import Icon from './Icon.astro';
import ResearchCardFigure from './ResearchCardFigure.astro';

interface Props {
  entry: Research;
  index?: number;
  size?: 'regular' | 'compact';
}

const { entry, index, size = 'regular' } = Astro.props;
const { data } = entry;
const figure = size !== 'compact' ? data.cardFigure : undefined;
const chart = !figure && size !== 'compact' ? data.charts?.[0] : undefined;
const numbers = !figure && !chart && size !== 'compact' ? data.keyNumbers?.slice(0, 2) : undefined;
const max = chart ? Math.max(...chart.items.map((item) => item.value)) : 1;
const decimals = chart?.items.some((item) => !Number.isInteger(item.value)) ? 2 : 0;
---

<article class:list={['rcard', `rcard--${size}`, 'cell', 'cell--link']} data-reveal data-vt-key={entry.id} data-loop-host>
  <header class="rcard__top">
    <p class="label">
      {index !== undefined && <span class="rcard__index numeric">{String(index).padStart(2, '0')}</span>}
      <span>{size === 'compact' ? RESEARCH_TYPES[data.type] : TOPICS[data.topics[0]!]}</span>
      {data.date && <time datetime={data.date}>{formatDateShort(data.date)}</time>}
    </p>
  </header>
  <span class="go" aria-hidden="true"><Icon name="arrow-right" /></span>

  <div class="rcard__body">
    <h3 class="rcard__title">
      <a class="stretched" href={researchPath(entry)}><span class="research-title" data-vt-title>{data.title}</span></a>
    </h3>
    {size !== 'compact' && <p class="rcard__summary">{data.summary}</p>}
  </div>

  {figure && (
    <div class="rcard__visual rcard__exhibit" data-vt-visual>
      <ResearchCardFigure figure={figure} />
    </div>
  )}

  {
    chart && (
      <div class="rcard__visual rcard__exhibit" data-vt-visual>
        <p class="label">
          {chart.title} · {chart.unit}
        </p>
        <dl class="rcard__chart">
          {chart.items.map((item, position) => (
            <div>
              <dt class="label">{item.label}</dt>
              <dd>
                <span class="rcard__bar" style={`width:${((item.value / max) * 100).toFixed(1)}%;--bar-order:${position}`} />
                <span class="rcard__value numeric">{item.value.toFixed(decimals)}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  {
    numbers && (
      <div class="rcard__visual rcard__exhibit rcard__exhibit--route" data-vt-visual>
        <svg class="rcard__route" viewBox="0 0 560 132" width="560" height="132" fill="none" aria-hidden="true" focusable="false">
          <g class="rcard__route-lines">
            <path d="M-20 12C110 12 124 61 245 61H325C427 61 437 12 580 12" />
            <path d="M-20 33C108 33 137 66 245 66H325C427 66 452 33 580 33" />
            <path d="M-20 54C104 54 140 71 245 71H325C431 71 457 54 580 54" />
            <path d="M-20 78C112 78 140 76 245 76H325C436 76 454 78 580 78" />
            <path d="M-20 101C112 101 144 81 245 81H325C427 81 452 101 580 101" />
            <path d="M-20 123C110 123 141 86 245 86H325C421 86 447 123 580 123" />
          </g>
          <path class="rcard__route-pulse" data-loop="3" d="M-20 33C108 33 137 66 245 66H325C427 66 452 33 580 33" />
          <g class="rcard__route-gates">
            <path d="M247 43V105M323 43V105" />
            <circle cx="247" cy="66" r="4" />
            <circle cx="323" cy="66" r="4" />
          </g>
        </svg>
        <dl class="rcard__numbers">
          {numbers.map((item) => (
            <div>
              <dt class="numeric">{item.value}</dt>
              <dd>{item.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  <p class="rcard__meta label">{data.venue.name}</p>
</article>

<style>
  .rcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-height: 100%;
  }

  .rcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--motion-base, 420ms) var(--ease-out, var(--ease));
  }

  .rcard:hover::before,
  .rcard:focus-within::before {
    transform: scaleX(1);
  }

  .rcard .go {
    position: absolute;
    top: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
    right: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
  }

  .rcard__top {
    min-height: 2.5rem;
    padding-right: 3.5rem;
  }

  .rcard__top .label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.1em;
    padding-top: 0.75rem;
  }

  .rcard__index {
    color: var(--cell-accent);
    transition: color var(--motion-base, 420ms) var(--ease);
  }

  .rcard__body {
    flex: 1;
  }

  .rcard__title {
    font-size: clamp(1.5rem, 1.12rem + 1.1vw, 2.1rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .rcard__title a {
    text-decoration: none;
  }

  .rcard--compact .rcard__title {
    font-size: var(--text-lg);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .rcard__summary {
    margin-top: var(--space-4);
    max-width: 38rem;
    color: var(--cell-muted);
    line-height: 1.55;
    transition: color var(--motion-base, 420ms) var(--ease);
  }

  /* The exhibits retain the report's actual figures, in an instrument-like panel. */
  .rcard__exhibit {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-width: 0;
    padding: clamp(1.25rem, 0.8rem + 1.5vw, 2rem);
    border: 1px solid #343a3f;
    border-radius: var(--radius-sm);
    background-color: #171b1e;
    background-image:
      radial-gradient(ellipse at 100% 0%, #ff6a3314, transparent 65%),
      linear-gradient(#eef0f108 1px, transparent 1px),
      linear-gradient(90deg, #eef0f108 1px, transparent 1px);
    background-size: auto, 32px 32px, 32px 32px;
    color: #eef0f1;
    transition:
      border-color var(--motion-base, 420ms) var(--ease),
      background-position var(--motion-slow, 800ms) var(--ease-out, var(--ease));
  }

  .rcard__exhibit::before,
  .rcard__exhibit::after {
    content: '';
    position: absolute;
    width: 5px;
    height: 5px;
    background: #ff6a33;
    opacity: 0.65;
    pointer-events: none;
  }

  .rcard__exhibit::before {
    top: 9px;
    left: 9px;
  }

  .rcard__exhibit::after {
    right: 9px;
    bottom: 9px;
  }

  .rcard:hover .rcard__exhibit,
  .rcard:focus-within .rcard__exhibit {
    border-color: #ff6a3380;
    background-position: 0 0, 0 -8px, 8px 0;
  }

  .rcard__visual > .label {
    position: relative;
    margin-bottom: var(--space-5);
    max-width: 30rem;
    color: #a2a9b0;
    font-size: 0.6875rem;
    line-height: 1.6;
  }

  .rcard__chart {
    display: grid;
    gap: 1.05rem;
    max-width: 32rem;
  }

  .rcard__chart > div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }

  .rcard__chart dd {
    position: relative;
    padding-right: 3.4rem;
  }

  .rcard__chart dt {
    color: #a2a9b0;
    font-size: 0.6875rem;
  }

  .rcard__bar {
    display: block;
    height: 0.85rem;
    min-width: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, #f04400, #ff8c5e);
    transform-origin: left center;
    transition:
      transform 1.1s var(--ease-out, var(--ease)) calc(var(--bar-order, 0) * 80ms),
      filter var(--motion-base, 420ms) var(--ease);
  }

  .rcard.reveal-wait .rcard__bar {
    transform: scaleX(0);
  }

  .rcard:hover .rcard__bar,
  .rcard:focus-within .rcard__bar {
    filter: brightness(1.18);
  }

  .rcard__value {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: 3rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    text-align: right;
    white-space: nowrap;
  }

  /* Two figures from the report */
  .rcard__exhibit--route {
    padding-top: 0;
  }

  .rcard__route {
    display: block;
    width: calc(100% + 4rem);
    max-width: none;
    height: 7.25rem;
    margin-inline: -2rem;
    margin-bottom: var(--space-4);
    overflow: visible;
    transition: transform var(--motion-slow, 800ms) var(--ease-out, var(--ease));
  }

  .rcard__route-lines {
    stroke: #eef0f13b;
    stroke-width: 1;
  }

  .rcard__route-pulse {
    stroke: #ff6a33;
    stroke-width: 2;
    stroke-dasharray: 28 600;
    stroke-dashoffset: -120;
  }

  .rcard__route-gates {
    stroke: #ff6a33;
    stroke-width: 1;
  }

  .rcard__route-gates circle {
    fill: #171b1e;
    stroke-width: 2;
  }

  .rcard.reveal-in .rcard__route-pulse {
    animation: route-pulse 6s linear infinite;
  }

  .rcard:hover .rcard__route,
  .rcard:focus-within .rcard__route {
    transform: scale(1.04);
  }

  .rcard__numbers {
    display: grid;
    gap: var(--space-4) var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rcard__numbers dt {
    color: #eef0f1;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.6rem);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .rcard__numbers dd {
    margin-top: var(--space-2);
    color: #a2a9b0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .rcard__meta {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    font-size: 0.6875rem;
    line-height: 1.6;
  }

  .rcard--compact .rcard__meta {
    margin-top: var(--space-4);
  }

  @keyframes route-pulse {
    from { stroke-dashoffset: 28; }
    to { stroke-dashoffset: -600; }
  }

  @media (max-width: 35.99rem) {
    .rcard__exhibit {
      padding-inline: 1rem;
    }

    .rcard__chart > div {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0.6rem;
    }

    .rcard__chart dd {
      padding-right: 3.1rem;
    }

    .rcard__numbers {
      gap: var(--space-3);
    }

    .rcard__numbers dd {
      font-size: 0.8125rem;
    }

    .rcard__route {
      width: calc(100% + 2rem);
      margin-inline: -1rem;
    }
  }

  @media (max-width: 22.99rem) {
    .rcard__numbers { grid-template-columns: 1fr; }
  }

  /* The cash bars are shorter than the other figures, so their panel grows to fill the card. */
  .rcard__exhibit:has(:global(.report-figure--cash-returns)) {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Touch screens have no hover, so the card crossing the middle of the screen is the
     live one: its line loads and its arrow turns in step with the scroll. */
  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .rcard {
        view-timeline: --rcard block;
      }

      .rcard::before {
        animation: rcard-bar linear both;
        transition: none;
      }

      .rcard .go {
        animation: rcard-go linear both;
      }
    }
  }

  /* The timelines sit in their own block, after the animations: the build otherwise folds
     a timeline into the animation shorthand, which browsers reject. */
  @supports (animation-timeline: view()) {
    @media (hover: none) and (prefers-reduced-motion: no-preference) {
      .rcard::before,
      .rcard .go {
        animation-timeline: --rcard;
        animation-range: cover 30% cover 70%;
      }
    }
  }

  @keyframes rcard-bar {
    0%,
    100% {
      transform: scaleX(0);
    }
    35%,
    65% {
      transform: scaleX(1);
    }
  }

  @keyframes rcard-go {
    0%,
    100% {
      transform: none;
    }
    35%,
    65% {
      transform: rotate(-45deg);
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rcard.reveal-wait .rcard__bar {
      transform: none;
    }

    .rcard.reveal-in .rcard__route-pulse {
      animation: none;
    }

    .rcard:hover .rcard__route,
    .rcard:focus-within .rcard__route {
      transform: none;
    }
  }

  @media print {
    .rcard__bar { transform: none !important; }
    .rcard__exhibit {
      background: none;
      color: #101214;
      border-color: #cfd4d8;
    }

    .rcard__visual > .label,
    .rcard__chart dt,
    .rcard__numbers dt,
    .rcard__numbers dd {
      color: #30353a;
    }

    .rcard__route {
      display: none;
    }
  }
</style>

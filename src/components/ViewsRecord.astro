---
// Views and outcomes: each dated view from a report, drawn as its range on a scale, with
// where the market actually finished once the view has come due. Whether the outcome was
// inside the range is worked out here from the numbers, never typed into the content file.
import { getCollection } from 'astro:content';
import latestPrices from '../data/latest-prices.json';
import { getPublicResearch, researchPath } from '../lib/content';
import { formatDateShort } from '../lib/dates';
import { chartObservation, entryMove, observationState, pendingState, type PriceObservation } from '../lib/price-status';

const prices = latestPrices as Record<string, PriceObservation>;
const now = new Date();

interface Props {
  /** Only the views from one report. Leave out for all of them. */
  report?: string;
  heading?: string;
}

const { report, heading = 'Views and outcomes' } = Astro.props;
const research = await getPublicResearch();
const allViews = await getCollection('views');
// A view that names a report that does not exist would otherwise vanish silently, missed or not.
const allResearch = await getCollection('research');
for (const { data: view } of allViews) {
  if (!allResearch.some((entry) => entry.id === view.report)) {
    throw new Error(`src/content/views.yaml: "${view.id}" names a report that does not exist: "${view.report}"`);
  }
  if (allResearch.find((entry) => entry.id === view.report)!.data.date !== view.formed) {
    throw new Error(`src/content/views.yaml: "${view.id}" must use its report's publication date`);
  }
  for (const key of [view.track, view.referenceTrack]) {
    if (key && !prices[key]) {
      throw new Error(`src/content/views.yaml: "${view.id}" references "${key}", which is not in src/data/latest-prices.json`);
    }
  }
  if (view.track && prices[view.track]!.unit !== view.range.unit) {
    throw new Error(`src/content/views.yaml: "${view.id}" tracks a price with a different unit from its benchmark`);
  }
}
const views = allViews
  .map((entry) => entry.data)
  .filter((view) => (report ? view.report === report : true))
  .filter((view) => research.some((entry) => entry.id === view.report))
  .sort((a, b) => a.due.localeCompare(b.due));

type View = (typeof views)[number];
const format = (value: number) =>
  value.toLocaleString('en-GB', { minimumFractionDigits: Number.isInteger(value) ? 0 : 2, maximumFractionDigits: 2 });
// Prices are shown to the precision their source quotes them (diesel to a tenth of a cent).
const formatPrice = (value: number) =>
  value.toLocaleString('en-GB', { minimumFractionDigits: Number.isInteger(value) ? 0 : 2, maximumFractionDigits: 3 });
const signed = (value: number) => `${value > 0 ? '+' : value < 0 ? '−' : ''}${formatPrice(Math.abs(value))}`;
const signedPercent = (value: number) => `${value > 0 ? '+' : value < 0 ? '−' : ''}${format(Math.abs(value))}`;
const units: Record<string, string> = {
  'US$ per barrel': 'US$/bbl', 'US$ per MMBtu': 'US$/MMBtu', 'US$ per day': 'US$/day',
  'US$ per tonne': 'US$/t', 'US$ per gallon': 'US$/gal',
};
const unit = (value: string) => units[value] ?? value;

// `status` is what the filter uses: inside, missed or open.
const verdict = (view: View) => {
  if (!view.outcome) {
    const state = pendingState(view, now);
    const text = state === 'outcome' ? 'Awaiting outcome' : 'Open';
    return { key: 'pending', status: 'open', text };
  }
  const { low, high } = view.range;
  if (low !== undefined && view.outcome.value < low) return { key: 'below', status: 'missed', text: 'Missed: below the range' };
  if (high !== undefined && view.outcome.value > high) return { key: 'above', status: 'missed', text: 'Missed: above the range' };
  return { key: 'inside', status: 'inside', text: 'Inside the range' };
};

// Each row gets a scale wide enough for its range and its outcome, with some air either side.
// A one-sided range runs off the edge of its scale on the open side.
const scale = (view: View) => {
  const { low, high } = view.range;
  const point = chartObservation(view, prices, now)?.value;
  const entry = view.entry?.value;
  const values = [low, high, view.outcome?.value, point, entry].filter((value): value is number => value !== undefined);
  const span = Math.max(Math.max(...values) - Math.min(...values), Math.max(...values.map(Math.abs)) * 0.15) || 1;
  const min = Math.min(...values) - span * 0.35;
  const max = Math.max(...values) + span * 0.35;
  const at = (value: number) => ((value - min) / (max - min)) * 100;
  const from = low !== undefined ? at(low) : 0;
  const to = high !== undefined ? at(high) : 100;
  return {
    from: from.toFixed(2),
    width: (to - from).toFixed(2),
    open: low === undefined ? 'left' : high === undefined ? 'right' : undefined,
    point: point !== undefined ? at(point).toFixed(2) : undefined,
    entry: entry !== undefined ? at(entry).toFixed(2) : undefined,
  };
};

const describe = (view: View) => {
  const { low, high } = view.range;
  if (low !== undefined && high !== undefined) return `${format(low)}–${format(high)}`;
  if (high !== undefined) return `≤ ${format(high)}`;
  return `≥ ${format(low!)}`;
};

const title = (id: string) => research.find((entry) => entry.id === id);
// Rows are grouped under the report they come from, newest report first.
const groups = [...new Set(views.map((view) => view.report))]
  .map((id) => ({ piece: title(id)!, views: views.filter((view) => view.report === id) }))
  .sort((a, b) => (b.piece.data.date ?? '').localeCompare(a.piece.data.date ?? ''));
const judged = views.filter((view) => view.outcome);
const inside = judged.filter((view) => verdict(view).key === 'inside').length;
const filters = [
  { key: '', label: 'All', count: views.length },
  { key: 'inside', label: 'Inside the range', count: inside },
  { key: 'missed', label: 'Missed', count: judged.length - inside },
  { key: 'open', label: 'Still open', count: views.length - judged.length },
];
---

{
  views.length > 0 && (
    <section class="record" id="views" aria-labelledby="views-heading" data-reveal>
      <div class="record__head">
        <h2 id="views-heading" class={report ? 'record__heading--block label label--marked' : 'record__heading'}>{heading}</h2>
        <p class="record__tally label numeric">
          <span>{judged.length} assessed</span>
          {judged.length > 0 && (
            <>
              {' '}
              <span>· {inside} inside the range</span> <span>· {judged.length - inside} missed</span>
            </>
          )}{' '}
          <span>· {views.length - judged.length} still open</span>
        </p>
      </div>
      {
        !report && (
          // Switched on by the script below. Without it, every view is listed.
          <div class="record__filters side-scroll" role="group" aria-label="Show views" data-record-filters hidden>
            {filters.map((filter) => (
              <button type="button" class="record__chip" data-status={filter.key} aria-pressed={filter.key === '' ? 'true' : 'false'}>
                {filter.label}
                <span class="record__chip-count numeric">
                  <span class="visually-hidden">, </span>
                  {filter.count}
                </span>
              </button>
            ))}
          </div>
        )
      }
      <div class="record__legend" aria-label="Chart legend">
        <span><i class="record__legend-entry" aria-hidden="true" />Entry line</span>
        <span><i class="record__legend-point" aria-hidden="true" />Current point</span>
        <span><i class="record__legend-band" aria-hidden="true" />Target band</span>
      </div>
      <p class="record__empty" data-record-empty hidden>None so far.</p>
      {groups.map((group) => (
        <div class="record__group" data-record-group>
          {!report && (
            <p class="record__report label">
              From <a href={researchPath(group.piece)}>{group.piece.data.title}</a>
            </p>
          )}
          <ol class="record__list">
            {group.views.map((view, index) => {
              const result = verdict(view);
              const place = scale(view);
              const observation = chartObservation(view, prices, now);
              const configuredPrice = prices[view.track ?? view.referenceTrack ?? ''];
              const freshness = configuredPrice ? observationState(configuredPrice, now) : undefined;
              const unavailable = !view.outcome && !observation;
              const change = entryMove(view, prices, now);
              const sourceUrl = observation?.sourceUrl ?? configuredPrice?.sourceUrl;
              const badge = observation?.kind === 'reference' ? (view.referenceTrack === 'jkm-indicative' ? 'Indicative' : 'Spot') : undefined;
              return (
                <li class:list={['record__row', `record__row--${result.key}`]} style={`--i:${index}`} data-status={result.status} data-view-id={view.id}>
                  <div class="record__what">
                    <p class="record__view" title={view.view}>{view.instrument}</p>
                    <p class="record__meta label">
                      Published <time datetime={view.formed}>{formatDateShort(view.formed)}</time>
                    </p>
                    {view.entry && (
                      <p class="record__detail" data-entry-price>
                        Entry <strong>{formatPrice(view.entry.value)}</strong> <span class="record__unit" title={view.range.unit}>{unit(view.range.unit)}</span>
                        {' '}· <time datetime={view.entry.date}>{formatDateShort(view.entry.date)}</time>
                      </p>
                    )}
                    {view.entryUnavailable && <p class="record__source" data-entry-unavailable title={view.entryUnavailable}>Entry unavailable</p>}
                  </div>
                  <div class="record__visual">
                    <p class="record__detail record__target">
                      Target{view.basis === 'average' ? ' avg' : ''} <strong>{describe(view)}</strong> <span class="record__unit" title={view.range.unit}>{unit(view.range.unit)}</span>
                      {' '}· <time datetime={view.due}>{formatDateShort(view.due)}</time>
                    </p>
                    <div class="record__chart" aria-hidden="true">
                      <span
                        class:list={['record__band', place.open && `record__band--open-${place.open}`]}
                        style={`left:${place.from}%;width:${place.width}%`}
                      />
                      {view.range.low !== undefined && (
                        <span class="record__end numeric" style={`left:${place.from}%`}>{format(view.range.low)}</span>
                      )}
                      {view.range.high !== undefined && (
                        <span class="record__end numeric" style={`left:${(Number(place.from) + Number(place.width)).toFixed(2)}%`}>
                          {format(view.range.high)}
                        </span>
                      )}
                      {place.point && <span class={observation?.kind === 'outcome' ? 'record__dot' : 'record__latest'} style={`left:${place.point}%`} data-chart-kind={observation?.kind} />}
                      {place.entry && <span class="record__entry" style={`left:${place.entry}%`} />}
                    </div>
                  </div>
                  <div class="record__result">
                    <p class="record__verdict">
                      <span class="record__flag" aria-hidden="true" />
                      {result.text}
                    </p>
                    {observation && (
                      <p class="record__detail" data-current-price data-price-reference={observation.kind === 'reference' || undefined} title={observation.source}>
                        {observation.kind === 'outcome' ? 'Outcome' : 'Current'} <strong>{formatPrice(observation.value)}</strong> <span class="record__unit" title={view.range.unit}>{unit(view.range.unit)}</span>
                        {' '}· <time datetime={observation.date}>{formatDateShort(observation.date)}</time>
                        {badge && <>{' '}<span class="record__badge" title={configuredPrice?.label}>{badge}</span></>}
                      </p>
                    )}
                    {change && (
                      <p class="record__detail record__move" data-price-change title={change.basis === 'reference' ? 'Related-market reference move since entry; not an assessed outcome' : 'Benchmark price move since entry'}>
                        Move <strong>{signed(change.absolute)}</strong> <span class="record__unit">{unit(view.range.unit)}</span>{change.percent !== undefined ? ` (${signedPercent(change.percent)}%)` : ''}
                      </p>
                    )}
                    <p class="record__source record__sources">
                      {view.entry?.sourceUrl && <a href={view.entry.sourceUrl} title={view.entry.source}>{view.entry.sourceLabel ?? 'Entry source'}</a>}
                      {sourceUrl && <a href={sourceUrl} title={observation?.source ?? configuredPrice?.source}>Price source</a>}
                    </p>
                    {unavailable && <p class="record__source" data-price-state="unavailable">Current unavailable</p>}
                    {!view.outcome && observation && freshness && (freshness.failed || freshness.stale) && (
                      <p class="record__source record__price-status" data-price-state={freshness.failed ? 'retained' : 'stale'} title={freshness.failed ? 'Latest refresh failed; last available observation retained' : 'Observation is older than the expected source cadence'}>
                        {freshness.failed ? 'Last available quote' : 'Older quote'}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
      <p class="record__note">
        Prices auto-refresh on weekdays; dates show the observation.{' '}
        {views.some((view) => view.referenceTrack === 'jkm-indicative') && 'JKM CFD quotes are indicative. '}
        Forecasts are assessed at their due dates; averages use the full period.
      </p>
      <details class="record__methodology">
        <summary>Methodology and benchmark notes</summary>
        <p class="record__source">
          Every published call and dated base-case benchmark view is included, including misses. Duplicate calls appear once.
          Entries are publication references, not executed trades. Moves are price changes, not forecast verdicts.
          Brent uses front-month futures. Related spot or indicative points are chart context; outcomes use the stated benchmark.
          Daily and weekly sources keep their actual observation dates.
        </p>
        {views.filter((view) => view.context).map((view) => <p class="record__source"><strong>{view.instrument}:</strong> {view.context}</p>)}
        {views.filter((view) => view.basis === 'average').map((view) => <p class="record__source">{view.view}.</p>)}
      </details>
    </section>
  )
}

<script>
  // Filter the record by result. The page lists every view without this.
  const filters = document.querySelector<HTMLElement>('[data-record-filters]');
  if (filters) {
    const record = filters.closest('.record')!;
    const chips = [...filters.querySelectorAll<HTMLButtonElement>('[data-status]')];
    const rows = [...record.querySelectorAll<HTMLElement>('.record__row')];
    const groups = [...record.querySelectorAll<HTMLElement>('[data-record-group]')];
    const empty = record.querySelector<HTMLElement>('[data-record-empty]');
    const show = (status: string) => {
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.status === status));
      for (const row of rows) row.hidden = Boolean(status) && row.dataset.status !== status;
      for (const group of groups) group.hidden = ![...group.querySelectorAll<HTMLElement>('.record__row')].some((row) => !row.hidden);
      if (empty) empty.hidden = rows.some((row) => !row.hidden);
    };
    for (const chip of chips) chip.addEventListener('click', () => show(chip.dataset.status ?? ''));
    filters.hidden = false;
  }
</script>

<style>
  .record {
    container-type: inline-size;
    margin-top: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
  }

  /* On a report page the heading matches the page's other section labels. */
  .record__heading--block {
    color: var(--ink);
    font-weight: 500;
  }

  .record__tally span {
    white-space: nowrap;
  }

  .record__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--ink);
  }

  .record__heading {
    font-size: var(--text-xl);
    letter-spacing: -0.025em;
  }

  .record__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .record__chip {
    position: relative;
    min-height: 2.5rem;
    padding: 0.35rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ink) 26%, transparent);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .record__chip:hover {
    border-color: var(--ink);
  }

  .record__chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .record__chip-count {
    margin-left: 0.5em;
    color: var(--muted);
  }

  .record__chip[aria-pressed='true'] .record__chip-count {
    color: color-mix(in srgb, var(--bg) 62%, transparent);
  }

  .record__empty {
    padding-block: var(--space-6);
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }

  .record__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-4);
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .record__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .record__legend i {
    display: inline-block;
    flex: none;
  }

  .record__legend-entry {
    width: 1px;
    height: 0.9rem;
    background: var(--ink);
  }

  .record__legend-point {
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }

  .record__legend-band {
    width: 1.5rem;
    height: 0.5rem;
    border: 1px solid var(--ink-2);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  /* Where the instrument trades now, for a view that is still open: a hollow marker,
     distinct from the solid dot of a final outcome. */
  .record__latest {
    position: absolute;
    top: calc(1.1rem - 0.45rem);
    width: 0.9rem;
    height: 0.9rem;
    margin-left: -0.45rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bg);
  }

  .record__entry {
    position: absolute;
    top: 0.55rem;
    width: 1px;
    height: 1.1rem;
    background: var(--ink);
  }

  .record__report {
    padding-top: var(--space-5);
    line-height: 1.6;
  }

  .record__report a {
    color: var(--ink);
  }

  .record__row {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .record__row > div {
    min-width: 0;
  }

  /* Three columns only when the record itself is wide enough, wherever it sits. */
  @container (min-width: 48rem) {
    .record__row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
      align-items: center;
      gap: var(--space-6);
    }
  }

  .record__view {
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .record__meta {
    margin-top: var(--space-2);
    line-height: 1.6;
  }

  .record__target {
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  /* The range as a band on a scale, with a dot where the market finished. */
  .record__chart {
    position: relative;
    height: 3.25rem;
    background: linear-gradient(var(--line), var(--line)) 0 1.1rem / 100% 1px no-repeat;
  }

  .record__band {
    position: absolute;
    top: calc(1.1rem - 0.35rem);
    height: 0.7rem;
    border: 1.5px solid var(--ink-2);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    transform-origin: left center;
  }

  /* A one-sided view fades out towards its open end. */
  .record__band--open-left {
    border-left: 0;
    mask-image: linear-gradient(90deg, transparent, #000 40%);
  }

  .record__band--open-right {
    border-right: 0;
    mask-image: linear-gradient(90deg, #000 60%, transparent);
  }

  .record__row--inside .record__band {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .record__end {
    position: absolute;
    top: 1.85rem;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .record__dot {
    position: absolute;
    top: calc(1.1rem - 0.45rem);
    width: 0.9rem;
    height: 0.9rem;
    margin-left: -0.45rem;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }

  .record__row--inside .record__dot {
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .record__verdict {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-weight: 600;
  }

  .record__flag {
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--muted);
  }

  .record__row--inside .record__flag {
    border-color: var(--accent);
    background: var(--accent);
  }

  .record__row--above .record__flag,
  .record__row--below .record__flag {
    border-color: var(--ink);
    background: var(--ink);
  }

  .record__row--pending .record__verdict {
    color: var(--muted);
    font-weight: 500;
  }

  .record__detail {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .record__detail strong {
    color: var(--ink);
    font-weight: 550;
  }

  .record__unit {
    white-space: nowrap;
  }

  .record__badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.625rem;
    vertical-align: 0.08em;
  }

  .record__source,
  .record__note {
    margin-top: var(--space-2);
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .record__price-status {
    color: var(--ink-2);
  }

  .record__sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .record__note {
    margin-top: var(--space-4);
    max-width: var(--measure);
  }

  .record__methodology {
    margin-top: var(--space-2);
    max-width: var(--measure);
  }

  .record__methodology summary {
    min-height: 2.75rem;
    padding-block: 0.65rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  /* On arrival each band draws out from its low end, then the outcome lands on the scale. */
  .record:global(.reveal-wait) .record__band {
    transform: scaleX(0);
  }

  .record:global(.reveal-wait) .record__latest {
    opacity: 0;
  }

  .record:global(.reveal-in) .record__latest {
    opacity: 1;
    transition: opacity 0.4s var(--ease) calc(0.85s + var(--i) * 120ms);
  }

  .record:global(.reveal-wait) .record__dot {
    opacity: 0;
    transform: translateY(-1rem);
  }

  .record:global(.reveal-in) .record__band {
    transform: none;
    transition: transform 0.8s var(--ease-out) calc(0.2s + var(--i) * 120ms);
  }

  .record:global(.reveal-in) .record__dot {
    opacity: 1;
    transform: none;

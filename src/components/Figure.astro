---
// An image from a report or project: a chart or screenshot with its caption and credit.
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
  credit: string;
}

const { src, alt, width, height, caption, credit } = Astro.props;
---

<figure class="figure" data-reveal>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  <figcaption>
    <p>{caption}</p>
    <p class="figure__credit">{credit}</p>
  </figcaption>
</figure>

<style>
  .figure img {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: var(--measure);
  }

  .figure__credit {
    margin-top: var(--space-1);
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>

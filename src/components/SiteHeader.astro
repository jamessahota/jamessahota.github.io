---
import { getProfile } from '../lib/content';
import { NAV } from '../site.config';
import Icon from './Icon.astro';

const profile = await getProfile();
const path = Astro.url.pathname;
// "page" marks the page you are on; "true" marks its section (a report inside Research).
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header">
  <div class="bar container">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand__mark" aria-hidden="true">JS</span>
      <span class="brand__name">James Sahota</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span data-nav-label>Menu</span>
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a class="nav__link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__link nav__link--cv" href="/cv/" aria-current={current('/cv/')}>CV</a>
        </li>
      </ul>
      <p class="nav__contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </nav>

    <p class="bar__clock label" data-clock-wrap hidden>
      Chicago <span class="numeric" data-clock="America/Chicago"></span>
    </p>

    <button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle hidden>
      <Icon name="theme" />
      <span class="visually-hidden">Dark theme</span>
    </button>
  </div>
</header>

<script>
  // --- Light and dark ------------------------------------------------------
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (themeToggle) {
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      themeToggle.setAttribute('aria-pressed', String(dark));
      // Keeps the phone browser's toolbar the same colour as the page.
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#101214' : '#eef0f1');
    };
    themeToggle.hidden = false;
    sync();
    themeToggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
      // Lets the hero illustration pick up the new colours.
      document.dispatchEvent(new CustomEvent('themechange'));
    });
  }

  // --- Menu on small screens ----------------------------------------------
  // The links are visible without JavaScript. With it, small screens get a toggle.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const label = toggle?.querySelector<HTMLElement>('[data-nav-label]');
  const outside = [document.getElementById('main'), document.querySelector('.site-footer')];

  if (toggle && nav && label) {
    root.classList.add('has-nav-toggle');
    toggle.hidden = false;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      label.textContent = open ? 'Close' : 'Menu';
      root.classList.toggle('nav-open', open);
      // While the menu covers the page, keep focus and screen readers inside it.
      for (const element of outside) element?.toggleAttribute('inert', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Close the menu if the window grows past the small-screen layout.
    window.matchMedia('(min-width: 56rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-4);
    min-height: var(--header-height);
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-right: auto;
    padding-block: 0.6rem;
    text-decoration: none;
  }

  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  /* The small square after the initials, as in the favicon. */
  .brand__mark::after {
    content: '';
    width: 3px;
    height: 3px;
    margin: 0.5em 0 0 1.5px;
    background: var(--accent);
    transition: background-color 0.3s var(--ease);
  }

  .brand:hover .brand__mark {
    background: var(--accent);
    color: var(--on-accent);
  }

  .brand:hover .brand__mark::after {
    background: var(--on-accent);
  }

  .brand__name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Navigation */
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(1rem, 0.2rem + 1.8vw, 2.25rem);
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* An underline that draws in from the left on hover and stays on the current page. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s var(--ease);
  }

  .nav__link:hover::after,
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .nav__link--cv {
    padding-inline: 0.9rem;
    min-height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--bg);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .nav__link--cv::after {
    display: none;
  }

  .nav__link--cv:hover,
  .nav__link--cv[aria-current] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .nav__contact {
    display: none;
  }

  /* Clock: wide screens only */
  .bar__clock {
    display: none;
    white-space: nowrap;
  }

  /* Theme switch and menu button */
  .theme-toggle,
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .theme-toggle:hover,
  .nav-toggle:hover {
    border-color: var(--ink);
  }

  .theme-toggle .icon {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.5s var(--ease);
  }

  .theme-toggle[aria-pressed='true'] .icon {
    transform: rotate(180deg);
  }

  .nav-toggle {
    display: none;
    order: 3;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Two short bars that cross when the menu is open. */
  .nav-toggle__icon {
    position: relative;
    width: 1rem;
    height: 0.5rem;
  }

  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .nav-toggle__icon::before {
    top: 0;
  }

  .nav-toggle__icon::after {
    bottom: 0;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::before {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::after {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Small screens: without JavaScript the links sit in a row under the bar.
     With it, they move into a full-screen menu behind the Menu button. */
  @media (max-width: 55.99rem) {
    .theme-toggle {
      order: 2;
    }

    .nav {
      order: 4;
      flex-basis: 100%;
      padding-bottom: var(--space-2);
    }

    :global(.has-nav-toggle) .nav-toggle {
      display: inline-flex;
    }

    /* Keep the bar on one row, so the menu panel always starts under it. */
    :global(.has-nav-toggle) .bar {
      flex-wrap: nowrap;
      gap: 0 var(--space-2);
    }

    :global(.has-nav-toggle) .nav {
      position: fixed;
      inset: calc(var(--header-height) + 1px) 0 0 0;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--space-5) var(--gutter) var(--space-6);
      background: var(--bg);
      overflow-y: auto;
    }

    :global(.has-nav-toggle) .nav[data-open] {
      display: flex;
    }

    :global(.has-nav-toggle) .nav ul {
      flex-direction: column;
      align-items: stretch;
    }

    :global(.has-nav-toggle) .nav li {
      border-bottom: 1px solid var(--line);
    }

    :global(.has-nav-toggle) .nav__link,
    :global(.has-nav-toggle) .nav__link--cv {
      display: flex;
      min-height: 0;
      padding: 1.1rem 0;
      border-radius: 0;
      background: none;
      color: var(--ink);
      font-family: var(--sans);
      font-size: clamp(2.25rem, 1.4rem + 4.5vw, 3.25rem);
      font-weight: 560;
      letter-spacing: -0.04em;
      line-height: 1;
      text-transform: none;
    }

    :global(.has-nav-toggle) .nav__link::after {
      display: none;
    }

    :global(.has-nav-toggle) .nav__link[aria-current] {
      color: var(--accent-text);
    }

    :global(.has-nav-toggle) .nav[data-open] li {
      animation: nav-in 0.5s var(--ease) backwards;
    }

    :global(.has-nav-toggle) .nav[data-open] li:nth-child(2) {
      animation-delay: 0.05s;
    }

    :global(.has-nav-toggle) .nav[data-open] li:nth-child(3) {
      animation-delay: 0.1s;
    }

    :global(.has-nav-toggle) .nav[data-open] li:nth-child(4) {
      animation-delay: 0.15s;
    }

    :global(.has-nav-toggle) .nav__contact {
      display: block;
      margin-top: var(--space-6);
      font-family: var(--mono);
      font-size: var(--text-sm);
    }

    :global(.nav-open) {
      overflow: hidden;
    }
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* On very narrow screens the mark stands in for the full name. */
  @media (max-width: 22.5rem) {
    :global(.has-nav-toggle) .brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (min-width: 56rem) {
    .bar {
      flex-wrap: nowrap;
      gap: 0 clamp(1rem, 0.2rem + 1.8vw, 2.25rem);
    }
  }

  @media (min-width: 72rem) {
    .bar__clock {
      display: block;
    }
  }
</style>

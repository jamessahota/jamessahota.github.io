---
import { getProfile } from '../lib/content';
import { NAV } from '../site.config';
import Icon from './Icon.astro';

const profile = await getProfile();
const path = Astro.url.pathname;
// "page" marks the page you are on; "true" marks its section (a report inside Research).
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header">
  <div class="bar container">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand__mark" aria-hidden="true">JS</span>
      <span class="brand__name">James Sahota</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span data-nav-label>Menu</span>
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Primary">
      <p class="nav__eyebrow label">Navigation</p>
      <ul>
        {
          NAV.map((item, index) => (
            <li style={`--nav-order:${index}`}>
              <a class="nav__link" href={item.href} aria-current={current(item.href)}>
                <span class="nav__number" aria-hidden="true">0{index + 1}</span>
                <span>{item.label}</span>
                <span class="nav__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
                {current(item.href) && <span class="nav__underline" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
        <li style="--nav-order:3">
          <a class="nav__link nav__link--cv" href="/cv/" aria-current={current('/cv/')}>
            <span class="nav__number" aria-hidden="true">04</span><span>CV</span>
            <span class="nav__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
          </a>
        </li>
        <li style="--nav-order:4">
          <a class="nav__link nav__link--contact" href="#contact">
            <span class="nav__number" aria-hidden="true">05</span><span>Contact</span>
            <span class="nav__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
          </a>
        </li>
      </ul>
      <div class="nav__utilities">
        <p class="nav__contact">
          <span class="label">Get in touch</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
      </div>
      <span class="nav__watermark" aria-hidden="true">JS</span>
    </nav>

    <p class="bar__clock label" data-clock-wrap hidden>
      Chicago <span class="numeric" data-clock="America/Chicago"></span>
    </p>

    <!-- The one control for motion: it stills every animation on every page, and is remembered. -->
    <button class="motion-toggle" type="button" data-motion-toggle data-paused="false" title="Pause animations" hidden>
      <span class="motion-toggle__pause" aria-hidden="true"><Icon name="pause" /></span>
      <span class="motion-toggle__play" aria-hidden="true"><Icon name="play" /></span>
      <span class="visually-hidden" data-motion-label>Pause animations</span>
    </button>

    <button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle hidden>
      <Icon name="theme" />
      <span class="visually-hidden">Dark theme</span>
    </button>
  </div>
</header>

<script>
  import { createThemeTransition } from '../lib/theme-transition';

  // --- Light and dark ------------------------------------------------------
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (themeToggle) {
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      themeToggle.setAttribute('aria-pressed', String(dark));
      // Keeps the phone browser's toolbar the same colour as the page.
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#101214' : '#efeee8');
    };
    themeToggle.hidden = false;
    sync();
    const setTheme = (next: string) => {
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
      // Lets illustrations pick up the new colours.
      document.dispatchEvent(new CustomEvent('themechange'));
    };
    const themeMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const themeTransition = createThemeTransition({
      root,
      applyTheme: setTheme,
      still: () => themeMotion.matches || root.dataset.motion === 'paused',
    });
    themeToggle.addEventListener('click', themeTransition.toggle);
    themeMotion.addEventListener('change', (event) => {
      if (event.matches) themeTransition.finish();
    });
    document.addEventListener('motionchange', (event) => {
      if ((event as CustomEvent<{ paused?: boolean }>).detail?.paused) themeTransition.finish();
    });
    window.addEventListener('pagehide', themeTransition.finish);
  }

  // One persisted motion setting controls CSS decoration and the route scene.
  const motionToggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const motionLabel = motionToggle?.querySelector<HTMLElement>('[data-motion-label]');
  const syncMotion = () => {
    const paused = root.dataset.motion === 'paused';
    if (motionToggle) motionToggle.dataset.paused = String(paused);
    if (motionLabel) motionLabel.textContent = paused ? 'Resume animations' : 'Pause animations';
    if (motionToggle) motionToggle.title = paused ? 'Resume animations' : 'Pause animations';
  };
  const applyMotion = (paused: boolean) => {
    if (paused) root.dataset.motion = 'paused';
    else delete root.dataset.motion;
    try { localStorage.setItem('motion', paused ? 'paused' : 'running'); } catch {}
    syncMotion();
  };
  document.addEventListener('motionchange', (event) => {
    const paused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused;
    if (typeof paused === 'boolean') applyMotion(paused);
    else syncMotion();
  });
  if (motionToggle) {
    // Nothing moves for visitors who ask for reduced motion, so there is nothing to pause.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionToggle.hidden = calm.matches;
    calm.addEventListener('change', () => { motionToggle.hidden = calm.matches; });
    syncMotion();
    motionToggle.addEventListener('click', () => {
      const paused = root.dataset.motion !== 'paused';
      applyMotion(paused);
      document.dispatchEvent(new CustomEvent('motionchange', { detail: { paused } }));
    });
  }
  window.addEventListener('storage', (event) => {
    if (event.key !== 'motion') return;
    const paused = event.newValue === 'paused';
    applyMotion(paused);
    document.dispatchEvent(new CustomEvent('motionchange', { detail: { paused } }));
  });

  // --- Menu on small screens ----------------------------------------------
  // The links are visible without JavaScript. With it, small screens get a toggle.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const label = toggle?.querySelector<HTMLElement>('[data-nav-label]');
  const outside = [document.getElementById('main'), document.querySelector('.site-footer')];

  if (toggle && nav && label) {
    root.classList.add('has-nav-toggle');
    toggle.hidden = false;
    const desktop = window.matchMedia('(min-width: 56rem)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const header = toggle.closest('header')!;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const finishClose = () => {
      nav.removeAttribute('data-closing');
      root.classList.remove('nav-open');
      for (const element of outside) element?.removeAttribute('inert');
    };

    const setOpen = (requested: boolean, immediate = false) => {
      const mobile = !desktop.matches;
      const open = requested && mobile;
      const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
      clearTimeout(closeTimer);
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      label.textContent = open ? 'Close' : 'Menu';

      // The closed panel stays in the DOM for its exit, but never in the tab order.
      nav.toggleAttribute('inert', mobile && !open);
      if (mobile) nav.setAttribute('aria-hidden', String(!open));
      else nav.removeAttribute('aria-hidden');

      if (open) {
        nav.removeAttribute('data-closing');
        root.classList.add('nav-open');
        for (const element of outside) element?.setAttribute('inert', '');
      } else {
        if (nav.contains(document.activeElement)) toggle.focus();
        // An immediate close skips the exit, so a page change never photographs a half-closed menu.
        nav.toggleAttribute('data-instant', immediate);
        if (immediate) requestAnimationFrame(() => requestAnimationFrame(() => nav.removeAttribute('data-instant')));
        if (mobile && wasOpen && !immediate && !reducedMotion.matches && root.dataset.motion !== 'paused') {
          nav.setAttribute('data-closing', '');
          // Match the panel's 560ms exit, with a small fallback margin.
          closeTimer = setTimeout(finishClose, 600);
        } else {
          finishClose();
        }
      }
    };

    setOpen(false, true);

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }

      if (event.key === 'Tab' && toggle.getAttribute('aria-expanded') === 'true') {
        const controls = [...header.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')]
          .filter((element) => element.getClientRects().length > 0 && !element.closest('[inert]'));
        const first = controls[0];
        const last = controls.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    nav.addEventListener('click', (event) => {
      const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>('a');
      if (!anchor) return;
      const destination = new URL(anchor.href, location.href);
      const samePageAnchor = destination.origin === location.origin && destination.pathname === location.pathname && Boolean(destination.hash);
      // Release the destination before the browser follows an in-page contact link.
      setOpen(false, samePageAnchor);
    });

    // Close the menu if the window grows past the small-screen layout.
    desktop.addEventListener('change', () => setOpen(false, true));
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches && nav.hasAttribute('data-closing')) setOpen(false, true);
    });
    document.addEventListener('motionchange', () => {
      if (root.dataset.motion === 'paused' && nav.hasAttribute('data-closing')) setOpen(false, true);
    });
    // A page restored from the browser's cache should always have a usable header.
    window.addEventListener('pageshow', () => setOpen(false, true));
    window.addEventListener('pageswap', () => setOpen(false, true));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    view-transition-name: site-header;
  }

  /* Frosted on wide screens. The prefixed and unprefixed properties sit in separate
     blocks because the build keeps only one of the pair when they share a rule, and
     the header must never be see-through without its blur. */
  @media (min-width: 56rem) {
    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
      .site-header {
        background: color-mix(in srgb, var(--bg) 88%, transparent);
      }
    }

    @supports (backdrop-filter: blur(1px)) {
      .site-header {
        backdrop-filter: blur(14px) saturate(1.2);
      }
    }

    @supports (-webkit-backdrop-filter: blur(1px)) {
      .site-header {
        -webkit-backdrop-filter: blur(14px) saturate(1.2);
      }
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-4);
    min-height: var(--header-height);
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-right: auto;
    padding-block: 0.6rem;
    text-decoration: none;
  }

  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform var(--motion-base, 420ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  /* The small square after the initials, as in the favicon. */
  .brand__mark::after {
    content: '';
    width: 3px;
    height: 3px;
    margin: 0.5em 0 0 1.5px;
    background: var(--accent);
    transition: background-color 0.3s var(--ease);
  }

  .brand:hover .brand__mark,
  .brand:focus-visible .brand__mark {
    background: var(--accent);
    color: var(--on-accent);
    transform: translateY(-2px) rotate(-5deg);
  }

  .brand:hover .brand__mark::after {
    background: var(--on-accent);
  }

  .brand__name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Navigation */
  .nav { display: flex; align-items: center; gap: clamp(0.9rem, 1.4vw, 1.8rem); }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(0.9rem, 0.1rem + 1.4vw, 1.8rem);
  }

  .nav__eyebrow, .nav__number, .nav__arrow, .nav__watermark { display: none; }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* An underline that draws in from the left on hover and stays on the current page. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s var(--ease);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  /* The current section's underline is a real element, so it can slide from one
     section to the next when the page changes. */
  .nav__link[aria-current]::after {
    display: none;
  }

  .nav__underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 2px;
    background: var(--accent);
    view-transition-name: nav-underline;
  }

  .nav__link--cv {
    padding-inline: 0.9rem;
    min-height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--bg);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .nav__link--cv::after {
    display: none;
  }

  .nav__link--cv:hover,
  .nav__link--cv[aria-current] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .nav__contact {
    display: none;
  }

  .nav__utilities { display: flex; align-items: center; }

  .motion-toggle__pause,
  .motion-toggle__play { display: inline-flex; font-size: 1rem; }
  .motion-toggle[data-paused='false'] .motion-toggle__play,
  .motion-toggle[data-paused='true'] .motion-toggle__pause { display: none; }
  /* Paused is a state worth seeing at a glance. */
  .motion-toggle[data-paused='true'] { color: var(--accent-text); }

  /* Clock: wide screens only */
  .bar__clock {
    display: none;
    white-space: nowrap;
  }

  /* Motion switch, theme switch and menu button */
  .motion-toggle,
  .theme-toggle,
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .motion-toggle:hover,
  .theme-toggle:hover,
  .nav-toggle:hover {
    border-color: var(--ink);
  }

  .theme-toggle .icon {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.5s var(--ease);
  }

  .theme-toggle[aria-pressed='true'] .icon {
    transform: rotate(180deg);
  }

  .nav-toggle {
    display: none;
    order: 3;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Two short bars that cross when the menu is open. */
  .nav-toggle__icon {
    position: relative;
    width: 1rem;
    height: 0.5rem;
  }

  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .nav-toggle__icon::before {
    top: 0;
  }

  .nav-toggle__icon::after {
    bottom: 0;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::before {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::after {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Small screens: without JavaScript the links sit in a row under the bar.
     With it, they move into a full-screen menu behind the Menu button. */
  @media (max-width: 55.99rem) {
    .motion-toggle,
    .theme-toggle {
      order: 2;
    }

    /* The two switches sit together, tight against the Menu button. */
    .motion-toggle,
    .theme-toggle {
      min-width: 2.5rem;
      padding-inline: 0.35rem;
    }

    .nav {
      order: 4;
      flex-basis: 100%;
      padding-bottom: var(--space-2);
    }

    :global(.has-nav-toggle) .nav-toggle {
      display: inline-flex;
    }

    /* Keep the bar on one row, so the menu panel always starts under it. */
    :global(.has-nav-toggle) .bar {
      flex-wrap: nowrap;
      gap: 0 var(--space-2);
    }

    :global(.has-nav-toggle) .nav {
      position: fixed;
      inset: calc(var(--header-height) + 1px) 0 auto 0;
      height: calc(100vh - var(--header-height) - 1px);
      height: calc(100dvh - var(--header-height) - 1px);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding: clamp(1.5rem, 4vh, 3rem) var(--gutter) var(--space-6);
      background: #101214;
      color: #f1f0e9;
      isolation: isolate;
      overflow-y: auto;
      visibility: hidden;
      pointer-events: none;
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: translateY(-0.75rem);
      transition:
        clip-path 560ms var(--ease-in-out, cubic-bezier(0.76, 0, 0.24, 1)),
        transform 560ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
        opacity 360ms ease,
        visibility 0s 560ms;
    }

    :global(.has-nav-toggle) .nav[data-open] {
      visibility: visible;
      pointer-events: auto;
      opacity: 1;
      clip-path: inset(0);
      transform: none;
      transition-delay: 0s;
    }

    :global(.has-nav-toggle) .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      position: relative;
      z-index: 1;
    }

    :global(.has-nav-toggle) .nav__eyebrow {
      display: block;
      position: relative;
      z-index: 1;
      color: #a2a9b0;
      margin-bottom: 0.75rem;
    }

    :global(.has-nav-toggle) .nav__watermark {
      display: block;
      position: absolute;
      right: -0.04em;
      bottom: -0.16em;
      z-index: 0;
      font-family: var(--display, var(--sans));
      font-size: clamp(19rem, 70vw, 35rem);
      line-height: 1;
      letter-spacing: -0.02em;
      color: #eef0f108;
      pointer-events: none;
      transform: translateY(2rem);
      transition: transform 900ms var(--ease-out);
    }

    :global(.has-nav-toggle) .nav[data-open] .nav__watermark { transform: none; }

    :global(.has-nav-toggle) .nav li {
      border-bottom: 1px solid #eef0f12a;
      opacity: 0;
      transform: translateY(1.75rem);
      transition:
        transform 620ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
        opacity 360ms ease;
    }

    :global(.has-nav-toggle) .nav__link,
    :global(.has-nav-toggle) .nav__link--cv {
      display: flex;
      min-height: 0;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.65rem 0;
      border-radius: 0;
      background: none;
      color: #f1f0e9;
      font-family: var(--display, var(--sans));
      font-size: clamp(2.7rem, 1.6rem + 7vw, 5rem);
      font-weight: 400;
      letter-spacing: -0.015em;
      line-height: 1.05;
      text-transform: uppercase;
      transition:
        color var(--motion-fast, 180ms) ease,
        padding-left var(--motion-base, 420ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    }

    :global(.has-nav-toggle) .nav__link:hover,
    :global(.has-nav-toggle) .nav__link:focus-visible {
      color: #ff6a33;
      padding-left: 0.45rem;
    }

    :global(.has-nav-toggle) .nav__link:focus-visible { outline-color: #ff6a33; }

    :global(.has-nav-toggle) .nav__number {
      display: block;
      min-width: 1.5rem;
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0;
      color: #a2a9b0;
      align-self: center;
    }

    :global(.has-nav-toggle) .nav__arrow {
      display: flex;
      margin-left: auto;
      align-self: center;
      font-size: 1.4rem;
      color: #ff6a33;
      transition: transform var(--motion-base) var(--ease-out);
    }

    :global(.has-nav-toggle) .nav__link:hover .nav__arrow { transform: translate(3px, -3px); }

    :global(.has-nav-toggle) .nav__link::after,
    :global(.has-nav-toggle) .nav__underline {
      display: none;
    }

    :global(.has-nav-toggle) .nav[data-instant],
    :global(.has-nav-toggle) .nav[data-instant] * {
      transition: none !important;
    }

    :global(.has-nav-toggle) .nav__link[aria-current] {
      color: #ff6a33;
    }

    :global(.has-nav-toggle) .nav[data-open] li {
      opacity: 1;
      transform: none;
      transition-delay: calc(110ms + var(--nav-order, 0) * 55ms);
    }

    :global(.has-nav-toggle) .nav[data-closing] li {
      transform: translateY(-1rem);
      transition-duration: 300ms;
      transition-delay: calc((4 - var(--nav-order, 0)) * 30ms);
    }

    :global(.has-nav-toggle) .nav__contact {
      display: block;
      margin-top: 0;
      font-family: var(--mono);
      font-size: var(--text-sm);
      position: relative;
      z-index: 1;
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity var(--motion-base, 420ms) ease,
        transform var(--motion-base, 420ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    }


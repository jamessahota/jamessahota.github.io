---
import type { Research } from '../lib/content';

interface Props {
  figure: NonNullable<Research['data']['cardFigure']>;
}

const { figure } = Astro.props;
const coinStacks = [{ x: 107, y: 117 }, { x: 280, y: 111 }, { x: 453, y: 117 }];
---

<div class:list={['report-figure', `report-figure--${figure.kind}`]}>
  <p class="report-figure__caption label">{figure.title}</p>

  {figure.kind === 'cash-returns' ? (
    <>
      <svg class="report-figure__drawing" viewBox="0 0 560 144" width="560" height="144" fill="none" aria-hidden="true" focusable="false">
        {coinStacks.map((stack, stackIndex) => (
          <g transform={`translate(${stack.x} ${stack.y})`}>
            <ellipse class="report-figure__coin-shadow" cx="0" cy="9" rx="62" ry="15" />
            {Array.from({ length: 5 }, (_, layer) => (
              <g transform={`translate(0 ${-layer * 12})`}>
                <g class="report-figure__coin" data-loop style={`--coin-delay:${stackIndex * -1.6 - layer * 0.14}s;--coin-lift:${4 + layer * 3}px`}>
                  <path class="report-figure__coin-edge" d="M-48-5A48 15 0 0 0 48-5V4A48 15 0 0 1-48 4Z" />
                  <ellipse class="report-figure__coin-face" cx="0" cy="-5" rx="48" ry="15" />
                  <ellipse class="report-figure__coin-rim" cx="0" cy="-5" rx="38" ry="10" />
                  <path class="report-figure__coin-mark" d="M-7-5H7M0-10V0" />
                  <path class="report-figure__coin-grooves" d="M-33 7V13M-20 11V17M-6 13V19M8 13V19M22 11V17M35 7V13" />
                </g>
              </g>
            ))}
          </g>
        ))}
      </svg>
      <div class="report-figure__legend" aria-hidden="true">
        <span>Cash generation</span><span>Capital returns</span>
      </div>
    </>
  ) : (
    <div class="report-figure__power" aria-hidden="true">
      <svg class="report-figure__connection" viewBox="0 0 560 144" width="560" height="144" fill="none" focusable="false">
        <path class="report-figure__wire" d="M140 72H420M224 60V84M336 60V84" />
        <path class="report-figure__signal" data-loop="3" pathLength="1000" d="M140 72H420" />
        <path class="report-figure__target" d="M322 66L328 72L322 78" />
      </svg>
      {figure.numbers.map((item, index) => (
        <svg class="report-figure__dial" viewBox="0 0 144 144" width="144" height="144" fill="none" focusable="false">
          <circle class="report-figure__orbit" cx="72" cy="72" r="66" />
          <circle class="report-figure__track" cx="72" cy="72" r="53" />
          <circle class:list={['report-figure__share', { 'report-figure__share--target': index === 1 }]} cx="72" cy="72" r="53" pathLength="100" stroke-dasharray={`${item.percentage} 100`} />
          <circle class="report-figure__sweep" data-loop="3" cx="72" cy="72" r="66" pathLength="100" />
          {index === 0 ? (
            <g class="report-figure__icon"><path d="M72 89V59M72 68L55 58M72 68L87 53M72 68L75 85" /><circle cx="72" cy="68" r="3" /></g>
          ) : (
            <g class="report-figure__icon"><path d="M61 72L69 80L84 63" /><path d="M72 48V53M72 91V96M48 72H53M91 72H96" /></g>
          )}
        </svg>
      ))}
    </div>
  )}

  <dl class="report-figure__numbers">
    {figure.numbers.map((item) => (
      <div>
        <dt class="numeric">{item.value}</dt>
        <dd>{item.label}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .report-figure { min-width: 0; }
  .report-figure__caption {
    color: #a2a9b0;
    font-size: 0.6875rem;
    line-height: 1.6;
    min-height: 2.2em;
  }
  .report-figure__drawing {
    display: block;
    width: 100%;
    height: 8.5rem;
    margin-block: 0.5rem 0;
    overflow: visible;
  }
  .report-figure__wire { stroke: #eef0f13b; stroke-width: 1; }
  .report-figure__signal {
    stroke: #ff6a33;
    stroke-width: 2;
    stroke-dasharray: 64 1000;
    stroke-dashoffset: -330;
    filter: drop-shadow(0 0 4px #ff6a3366);
  }
  .report-figure__coin-shadow { fill: #000; opacity: 0.28; }
  .report-figure__coin-edge { fill: #9a3c1c; stroke: #ff6a33; stroke-width: 0.9; }
  .report-figure__coin-face { fill: #2b2724; stroke: #ff9b73; stroke-width: 1.2; }
  .report-figure__coin-rim { stroke: #ff6a336e; stroke-width: 0.8; }
  .report-figure__coin-mark { stroke: #ffd0b8; stroke-width: 1.2; }
  .report-figure__coin-grooves { stroke: #ff9b736b; stroke-width: 0.8; }
  .report-figure__legend {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    color: #a2a9b0;
    font-family: var(--mono);
    font-size: 0.625rem;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.035em;
  }
  .report-figure__power {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-items: center;
    margin-block: 0.5rem 1.5rem;
    padding-bottom: 0.875rem;
  }
  .report-figure__connection { position: absolute; inset: 0; width: 100%; height: 8.5rem; }
  .report-figure__dial { position: relative; width: 8.5rem; max-width: 100%; height: 8.5rem; }
  .report-figure__orbit { stroke: #eef0f126; stroke-dasharray: 1 5; }
  .report-figure__track { stroke: #eef0f114; stroke-width: 5; }
  .report-figure__share {
    stroke: #ff6a33;
    stroke-width: 5;
    stroke-linecap: butt;
    transform: rotate(-90deg);
    transform-origin: 72px 72px;
  }
  .report-figure__share--target { stroke: #ff9b73; stroke-width: 2; }
  .report-figure__sweep {
    stroke: #ff6a33;
    stroke-width: 2;
    stroke-dasharray: 6 94;
    stroke-dashoffset: -20;
    transform: rotate(-90deg);
    transform-origin: 72px 72px;
  }
  .report-figure__icon { stroke: #c2c8cd; stroke-width: 1.5; }
  .report-figure__target { stroke: #ff6a33; stroke-width: 1.5; }
  .report-figure__numbers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-5); }
  .report-figure__numbers dt {
    color: #eef0f1;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.6rem);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .report-figure__numbers dd { margin-top: var(--space-2); color: #a2a9b0; font-size: var(--text-sm); line-height: 1.4; }
  :global(.rcard.reveal-in) .report-figure__signal { animation: report-signal 6s linear infinite; }
  :global(.rcard.reveal-in) .report-figure__sweep { animation: report-sweep 6s linear infinite; }
  :global(.rcard.reveal-in) .report-figure__coin { animation: cash-stack 7s var(--ease-in-out, ease-in-out) var(--coin-delay) infinite; }

  @keyframes report-signal { from { stroke-dashoffset: 64; } to { stroke-dashoffset: -1000; } }
  @keyframes report-sweep { to { stroke-dashoffset: -120; } }
  @keyframes cash-stack {
    0%, 15%, 85%, 100% { transform: translateY(0); }
    42%, 58% { transform: translateY(calc(-1 * var(--coin-lift))); }
  }

  @media (max-width: 35.99rem) {
    .report-figure__numbers { gap: var(--space-3); }
    .report-figure__numbers dd { font-size: 0.8125rem; }
    .report-figure__legend { font-size: 0.5625rem; }
  }
  @media (max-width: 22.99rem) {
    .report-figure__numbers { grid-template-columns: 1fr; gap: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .report-figure__signal, .report-figure__sweep, .report-figure__coin { animation: none !important; }
  }
</style>

---
// A ruled row of headline figures taken from a report, each with a plain-language label.
interface Props {
  items: { value: string; label: string }[];
  note?: string;
  heading?: string;
}

const { items, note, heading = 'Key numbers' } = Astro.props;
---

<section class="key-numbers" aria-label={heading} data-reveal>
  <dl class="cells key-numbers__grid" data-count={items.length}>
    {
      items.map((item, position) => (
        <div class="cell" style={`--i:${position}`}>
          <dt class="key-numbers__value numeric">
            <span>{item.value}</span>
          </dt>
          <dd class="key-numbers__label">{item.label}</dd>
        </div>
      ))
    }
  </dl>
  {note && <p class="key-numbers__note">{note}</p>}
</section>

<style>
  /* Two across on narrow screens, all in one row when there is room. */
  .key-numbers {
    container-type: inline-size;
  }

  .key-numbers__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .key-numbers__grid[data-count='1'],
  .key-numbers__grid[data-count='3'] {
    grid-template-columns: minmax(0, 1fr);
  }

  /* A single figure keeps the width of one cell rather than stretching across the column. */
  .key-numbers__grid[data-count='1'] {
    max-width: 24rem;
  }

  @container (min-width: 34rem) {
    .key-numbers__grid[data-count='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (min-width: 46rem) {
    .key-numbers__grid[data-count='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .key-numbers__value {
    /* Shrinks on the narrowest screens so a figure such as US$105.26 fits its cell. */
    font-size: clamp(1.25rem, 6.2vw, clamp(1.45rem, 1.1rem + 1.25vw, 2.125rem));
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.05em;
    /* Keep a figure in one piece. */
    white-space: nowrap;
  }

  /* Each figure lands whole: it rises from behind a mask, already correct on its
     first visible frame, and an orange tick is drawn under it. It never counts up,
     because a count would pass through values that were never true. */
  .key-numbers__value {
    position: relative;
    overflow: clip;
    padding-bottom: 0.55rem;
  }

  .key-numbers__value span {
    display: block;
    padding-bottom: 0.04em;
  }

  .key-numbers__value::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1.5rem;
    height: 2px;
    background: var(--accent);
    transform-origin: left center;
  }

  .key-numbers:global(.reveal-wait) .key-numbers__value span {
    transform: translateY(115%);
  }

  .key-numbers:global(.reveal-wait) .key-numbers__value::after {
    transform: scaleX(0);
  }

  .key-numbers:global(.reveal-wait) .key-numbers__label {
    opacity: 0;
  }

  .key-numbers:global(.reveal-in) .key-numbers__value span {
    transform: none;
    transition: transform 0.9s var(--ease-out) calc(0.15s + var(--i) * 90ms);
  }

  .key-numbers:global(.reveal-in) .key-numbers__value::after {
    transform: none;
    transition: transform 0.6s var(--ease-out) calc(0.55s + var(--i) * 90ms);
  }

  .key-numbers:global(.reveal-in) .key-numbers__label {
    opacity: 1;
    transition: opacity 0.6s var(--ease) calc(0.45s + var(--i) * 90ms);
  }

  @media print {
    .key-numbers .key-numbers__value span,
    .key-numbers .key-numbers__value::after {
      transform: none !important;
    }

    .key-numbers .key-numbers__label {
      opacity: 1 !important;
    }
  }

  .key-numbers__label {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--muted);
  }

  .key-numbers__note {
    margin-top: var(--space-3);
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--muted);
    max-width: var(--measure);
  }
</style>

---
import type { Research } from '../lib/content';
import { curveGeometry } from '../lib/curve';
import { TOPICS } from '../site.config';
import ResearchExhibit from './ResearchExhibit.astro';

interface Props { entry: Research; compact?: boolean; }
const { entry, compact = false } = Astro.props;
const { data } = entry;
const key = entry.id.replace(/[^a-zA-Z0-9_-]/g, '-');
const chart = data.charts?.[0];
const exhibit = data.headerVisual;
const kind = data.topics[0] === 'refining-products' ? 'refining'
  : data.topics.includes('shipping-chokepoints') && data.topics[0] !== 'oil-markets' ? 'routes'
  : data.topics[0] === 'gas-lng' ? 'gas'
  : data.topics[0] === 'oil-markets' ? 'oil' : 'network';
// A chart marked `kind: futures-curve` in the report's front matter is drawn as a line.
const isCurve = chart?.kind === 'futures-curve';
const items = chart?.items ?? [];
const max = Math.max(...items.map((item) => item.value), Number.MIN_VALUE);
const numbers = data.keyNumbers?.slice(0, 2) ?? [];
const geometry = isCurve ? curveGeometry(items, { left: 52, right: 588, top: 30, bottom: 220 }) : undefined;
const curvePoints = geometry?.points ?? [];
const curve = geometry?.line ?? '';
const gridId = 'visual-grid-' + key;
const glowId = 'visual-glow-' + key;
const showArt = isCurve || kind === 'refining' || kind === 'routes' || kind === 'gas';
if (!exhibit && !chart && !showArt) {
  throw new Error(`Research ${entry.id} needs a report-specific headerVisual or a chart`);
}
---

<figure
  class:list={['rvisual', 'rvisual--' + kind, { 'rvisual--compact': compact, 'rvisual--exhibit': Boolean(exhibit) }]}
  style={compact ? 'view-transition-name:research-visual-' + key : undefined}
  data-vt-visual
  data-loop-host
  data-research-visual={exhibit?.kind ?? (isCurve ? 'curve' : kind)}
  data-reveal
>
  <div class="rvisual__top">
    <span class="label">{TOPICS[data.topics[0]!]}</span>
    <span class="rvisual__signal" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>

  {exhibit && <ResearchExhibit exhibit={exhibit} />}

  {!exhibit && showArt && (
  <div class="rvisual__art">
    <svg class="rvisual__drawing" viewBox="0 0 640 280" width="640" height="280" fill="none" aria-hidden="true" focusable="false">
      <defs>
        <pattern id={gridId} width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" stroke="currentColor" stroke-opacity=".09" /></pattern>
        <radialGradient id={glowId}><stop stop-color="#ff6a33" stop-opacity=".22" /><stop offset="1" stop-color="#ff6a33" stop-opacity="0" /></radialGradient>
      </defs>
      <rect width="640" height="280" fill={'url(#' + gridId + ')'} />
      <ellipse cx="420" cy="140" rx="230" ry="160" fill={'url(#' + glowId + ')'} />
      {
        isCurve ? (
          <g class="rvisual__curve">
            {geometry!.ticks.map((tick) => (
              <g>
                <path d={'M52 ' + tick.y.toFixed(2) + 'H588'} stroke="currentColor" stroke-opacity=".12" />
                <text class="rvisual__tick" x="44" y={tick.y + 4} text-anchor="end">{tick.value}</text>
              </g>
            ))}
            <path d={curve + ' L588,248 L52,248Z'} fill="#ff6a33" fill-opacity=".055" />
            <path class="rvisual__curve-line" d={curve} pathLength="1" stroke="#ff6a33" stroke-width="3" />
            {curvePoints.map((point) => (
              <g class="rvisual__point" style={'--reached:' + point.reached.toFixed(3)}>
                <path d={'M' + point.x + ',' + point.y + 'V248'} stroke="#ff6a33" stroke-opacity=".2" stroke-dasharray="2 6" />
                <circle cx={point.x} cy={point.y} r="11" fill="#ff6a33" fill-opacity=".12" />
                <circle cx={point.x} cy={point.y} r="4" fill="#ff8a5c" />
              </g>
            ))}
          </g>
        ) : kind === 'refining' ? (
          <g class="rvisual__machine">
            <g stroke="#eef0f1" stroke-opacity=".28">
              <path d="M56 188H174L226 137H286M362 137H407L465 80H584M408 137L468 194H584" />
              <path d="M56 200H178L231 149H286M362 149H412L471 92H584M412 149L471 206H584" />
              {[0, 1, 2].map((i) => <path d={'M' + (286 + i * 25) + ' 64V219L' + (311 + i * 25) + ' 203V48Z'} fill="#eef0f1" fill-opacity={String(.035 + i * .025)} />)}
              <path d="M286 64L311 48H361V203L336 219H286Z" />
              <path d="M286 87H337M286 111H337M286 135H337M286 159H337M286 183H337" />
            </g>
            <path class="rvisual__traveller" data-loop="3" d="M56 194H176L229 143H327L337 137H410L468 86H584" pathLength="1" stroke="#ff6a33" stroke-width="3" />
            <path d="M322 74V207" stroke="#ff6a33" stroke-width="3" />
            <circle cx="56" cy="194" r="7" fill="#171a1d" stroke="#ff6a33" stroke-width="2" />
            <circle cx="584" cy="86" r="7" fill="#171a1d" stroke="#eef0f1" stroke-opacity=".6" />
            <circle cx="584" cy="200" r="7" fill="#171a1d" stroke="#eef0f1" stroke-opacity=".6" />
          </g>
        ) : kind === 'routes' || kind === 'gas' ? (
          <g class="rvisual__routes">
            <g class="rvisual__land" stroke="#eef0f1" stroke-opacity=".15">
              {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={'M-20 ' + (28 + i * 12) + 'C130 ' + (20 + i * 10) + ' 184 96 274 114L313 126M327 154L364 166C455 184 489 ' + (190 + i * 9) + ' 660 ' + (188 + i * 13)} />)}
              {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={'M-20 ' + (208 + i * 12) + 'C132 ' + (204 + i * 11) + ' 182 173 275 145L314 133M327 147L363 137C457 109 498 ' + (40 + i * 11) + ' 660 ' + (26 + i * 13)} />)}
            </g>
            <path class="rvisual__route-track" d="M38 224C147 224 195 159 279 139L321 136L362 147C449 164 473 57 602 57" stroke="#eef0f1" stroke-opacity=".42" stroke-width="1.5" />
            <path class="rvisual__traveller" data-loop="3" d="M38 224C147 224 195 159 279 139L321 136L362 147C449 164 473 57 602 57" pathLength="1" stroke="#ff6a33" stroke-width="3" />
            <path d="M297 112L290 158M347 118L340 164" stroke="#ff6a33" stroke-width="2" />
            <ellipse cx="320" cy="138" rx="47" ry="35" stroke="#ff6a33" stroke-opacity=".22" />
            <g fill="#171a1d" stroke="#eef0f1" stroke-opacity=".65"><circle cx="38" cy="224" r="6" /><circle cx="602" cy="57" r="6" /></g>
            <circle class="rvisual__beacon" data-loop="5" cx="320" cy="138" r="6" fill="#ff6a33" />
          </g>
        ) : null
      }
    </svg>
    {!isCurve && <span class="rvisual__illustration label">Illustration</span>}
  </div>
  )}

  {
    !exhibit && (chart ? (
      <div class:list={['rvisual__data', { 'rvisual__data--curve': isCurve }]}>
        <p class="rvisual__data-title label">{chart.title} · {chart.unit}</p>
        <dl class:list={['rvisual__values', { 'rvisual__values--bars': !isCurve }]}>
          {items.map((item, i) => (
            <div style={'--bar-order:' + i}>
              <dt>{item.label}</dt>
              <dd>
                {!isCurve && <span class="rvisual__bar" style={'width:' + ((item.value / max) * 100).toFixed(2) + '%'} />}
                <span>{Number.isInteger(item.value) ? item.value : item.value.toFixed(2)}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ) : numbers.length > 0 && (
      <dl class="rvisual__numbers">
        {numbers.map((number) => <div><dt>{number.value}</dt><dd>{number.label}</dd></div>)}
      </dl>
    ))
  }
  <figcaption class="rvisual__caption">
    {exhibit && data.originalUrl ? <a href={data.originalUrl} rel="noopener">{exhibit.source}</a> : exhibit?.source ?? (chart ? chart.source : data.dataAsOf ?? data.keyNumbersNote ?? data.venue.name)}
  </figcaption>
</figure>

<style>
  .rvisual { position: relative; isolation: isolate; display: flex; flex-direction: column; min-width: 0; margin: 0; overflow: hidden; border: 1px solid #ffffff26; border-radius: 2px; background: #171a1d; color: #eef0f1; box-shadow: 0 20px 70px #00000012; }
  .rvisual::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(135deg, #ffffff09, transparent 45%); }
  .rvisual__top { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem 0; gap: 1rem; }
  .rvisual__top .label { color: #c3c9cd; font-size: .65rem; }
  .rvisual__signal { display: flex; align-items: end; gap: 3px; height: 12px; }
  .rvisual__signal i { width: 3px; height: 5px; background: #ff6a33; }
  .rvisual__signal i:nth-child(2) { height: 9px; opacity: .65; }
  .rvisual__signal i:nth-child(3) { height: 12px; opacity: .35; }
  .rvisual__art { position: relative; display: grid; align-items: center; flex: 1; min-height: 13rem; }
  .rvisual__drawing { display: block; width: 100%; height: auto; color: #eef0f1; transform: translate(var(--visual-shift-x, 0px), var(--visual-shift-y, 0px)); transition: transform 1s var(--ease-out, ease); }
  .rvisual__illustration { position: absolute; right: 1.5rem; bottom: .5rem; color: #8b939a; font-size: .55rem; }
  .rvisual__data, .rvisual__numbers { position: relative; margin: 0 1.5rem; padding-block: 1.1rem; border-top: 1px solid #ffffff24; }
  .rvisual__data-title { color: #aeb6bd; font-size: .625rem; line-height: 1.6; margin-bottom: 1rem; max-width: 34rem; }
  .rvisual__values { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .75rem; }
  .rvisual__values dt { color: #9ba5ae; font-family: var(--mono); font-size: .65rem; line-height: 1.4; }
  .rvisual__values dd { margin: .45rem 0 0; font-family: var(--mono); font-size: clamp(.85rem, 1.1vw, 1.1rem); }
  .rvisual__values--bars { grid-template-columns: minmax(0, 1fr); gap: .9rem; }
  .rvisual__values--bars > div { display: grid; grid-template-columns: 8.25rem minmax(0, 1fr); gap: 1rem; align-items: center; }
  .rvisual__values--bars dd { position: relative; padding-right: 3.5rem; margin: 0; }
  .rvisual__values--bars dd > span:last-child { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: .8rem; }
  .rvisual__bar { display: block; height: .55rem; transform-origin: left center; background: linear-gradient(90deg, #f04400, #ffa079); }
  .rvisual.reveal-in .rvisual__bar { animation: bar-arrive 1.5s var(--ease-out, ease) calc(var(--bar-order) * .1s) both; }
  .rvisual__numbers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .rvisual__numbers dt { font-size: clamp(1.7rem, 2.5vw, 3rem); line-height: 1; font-weight: 550; letter-spacing: -.05em; }
  .rvisual__numbers dd { margin: .65rem 0 0; max-width: 20rem; font-size: .75rem; line-height: 1.5; color: #aeb6bd; }
  .rvisual__caption { margin: 0 1.5rem; padding: .8rem 0 1.15rem; border-top: 1px solid #ffffff16; font-family: var(--mono); font-size: .55rem; line-height: 1.6; color: #8f9aa4; }
  .rvisual__caption a { color: inherit; text-underline-offset: .2em; }
  .rvisual__caption a:hover { color: #eef0f1; }
  .rvisual--exhibit .rvisual__caption { font-size: .625rem; }
  .rvisual__tick { fill: #8f9aa4; font-family: var(--mono); font-size: 11px; }
  .rvisual__traveller { stroke-dasharray: .085 .915; stroke-dashoffset: .2; }
  .rvisual__curve-line { stroke-dasharray: 1; }
  .rvisual__beacon { transform-box: fill-box; transform-origin: center; }
  .rvisual.reveal-in .rvisual__traveller { animation: visual-flow 5s linear infinite; }
  /* The line draws at a steady pace, and each marker switches on as the line reaches it. */
  .rvisual.reveal-in .rvisual__curve-line { animation: curve-arrive 1.6s linear .2s both; }
  .rvisual.reveal-in .rvisual__point { animation: point-arrive .5s var(--ease-out, ease) calc(.2s + var(--reached) * 1.6s) both; }
  .rvisual.reveal-in .rvisual__beacon { animation: beacon 3s ease-in-out infinite; }
  .rvisual--compact .rvisual__top { padding: 1rem 1rem 0; }
  .rvisual--compact .rvisual__art { min-height: 9rem; max-height: 12rem; overflow: hidden; }
  .rvisual--compact .rvisual__data, .rvisual--compact .rvisual__numbers { margin-inline: 1rem; padding-block: .8rem; }
  .rvisual--compact .rvisual__caption { margin-inline: 1rem; }
  .rvisual--compact .rvisual__numbers dt { font-size: 1.8rem; }
  .rvisual--compact .rvisual__data-title { font-size: .55rem; }
  @keyframes visual-flow { to { stroke-dashoffset: -.8; } }
  @keyframes curve-arrive { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes point-arrive { from { opacity: 0; } to { opacity: 1; } }
  @keyframes bar-arrive { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes beacon { 50% { opacity: .45; transform: scale(.7); } }
  @media (max-width: 47.99rem) {
    .rvisual__art { min-height: 10rem; }
    .rvisual__data, .rvisual__numbers, .rvisual__caption { margin-inline: 1rem; }
    .rvisual__top { padding: 1rem 1rem 0; }
    .rvisual__values { gap: .35rem; }
    .rvisual__values dt { font-size: .6rem; }
    .rvisual__values dd { font-size: .8rem; }
    .rvisual__values--bars > div { grid-template-columns: 6rem minmax(0, 1fr); gap: .6rem; }
    .rvisual__numbers { gap: 1rem; }
    .rvisual__numbers dt { font-size: 1.9rem; }
    .rvisual__numbers dd { font-size: .7rem; }
  }
  @media (prefers-reduced-motion: reduce) { .rvisual * { animation: none !important; transition: none !important; } }
  @media print { .rvisual { background: #fff; color: #101214; box-shadow: none; border-color: #cfd4d8; } .rvisual * { animation: none !important; } .rvisual__art { display: none; } .rvisual__data-title, .rvisual__values dt, .rvisual__caption, .rvisual__numbers dd { color: #30353a; } }
</style>

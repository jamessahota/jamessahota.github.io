---
// One role on the Experience page: who, what, when, and two to four contributions.
import Icon from './Icon.astro';
import { formatPeriod } from '../lib/dates';

interface Props {
  id: string;
  organisation: string;
  url?: string;
  role: string;
  kind: string;
  location?: string;
  start: string;
  end?: string;
  highlights: string[];
  related?: { label: string; href: string };
  index?: number;
}

const { id, organisation, url, role, kind, location, start, end, highlights, related, index } = Astro.props;
---

<article class="role" id={id} data-reveal data-role>
  <span class="role__marker numeric" aria-hidden="true">{index !== undefined ? String(index).padStart(2, '0') : '·'}</span>
  <div class="role__aside">
    <p class="label numeric">{formatPeriod(start, end)}</p>
    {location && <p class="label">{location}</p>}
    <p class="role__kind">{kind}</p>
  </div>
  <div class="role__main">
    <h3>
      {
        url ? (
          <a class="quiet-link" href={url} rel="noopener">
            {organisation}
          </a>
        ) : (
          organisation
        )
      }
    </h3>
    <p class="role__title">{role}</p>
    <ul class="role__highlights">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    {
      related && (
        <a class="arrow-link" href={related.href}>
          {related.label}
          <Icon name="arrow-right" />
        </a>
      )
    }
  </div>
</article>

<script>
  const roles = document.querySelectorAll<HTMLElement>('[data-role]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('is-current', entry.isIntersecting);
    }, { rootMargin: '-18% 0px -38% 0px', threshold: 0 });
    roles.forEach((role) => observer.observe(role));
  }
</script>

<style>
  .role {
    position: relative;
    display: grid;
    gap: var(--space-4) var(--space-6);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem) 0 clamp(1.5rem, 1rem + 2vw, 3rem) 4.5rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .role::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .role::after {
    content: '';
    position: absolute;
    left: 1rem;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: scaleY(0);
    transform-origin: top;
    background: linear-gradient(transparent, var(--accent), transparent);
    transition: transform 1.1s var(--ease-out, ease);
  }

  .role.is-current::after,
  .role:focus-within::after { transform: scaleY(1); }

  .role__marker {
    position: absolute;
    display: grid;
    place-items: center;
    z-index: 1;
    top: clamp(1.5rem, 1rem + 2vw, 3rem);
    left: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.625rem;
    transition: background-color 500ms var(--ease), color 500ms var(--ease), border-color 500ms var(--ease);
  }

  .is-current .role__marker,
  .role:focus-within .role__marker { color: #101214; background: var(--accent); border-color: var(--accent); }

  @media (min-width: 56rem) {
    .role {
      grid-template-columns: 13rem minmax(0, 1fr);
      padding-block: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    }
  }

  .role__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  @media (min-width: 56rem) {
    .role__aside {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-top: 0.5rem;
    }
  }

  .role__kind {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .role h3 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
    transition: color 200ms ease;
  }

  /* The heading follows interaction, while scrolling only lights the timeline.
     Let the link inherit the heading's animated colour without a second fade. */
  .role h3 a {
    color: inherit;
    transition: text-decoration-color 200ms ease;
  }

  .role:focus-within h3 { color: var(--accent-text); }

  @media (hover: hover) {
    .role:hover h3 { color: var(--accent-text); }
  }

  .role__title {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    color: var(--ink-2);
  }

  .role__highlights {
    margin-top: var(--space-5);
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .role__highlights li {
    position: relative;
    padding-left: 1.5rem;
  }

  .role__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.75rem;
    height: 1px;
    background: var(--accent-text);
  }

  .role__highlights li + li {
    margin-top: 0.6em;
  }

  .role .arrow-link {
    margin-top: var(--space-4);
  }

  @media (max-width: 35.99rem) {
    .role { padding-left: 3rem; }
  }

  @media print {
    .role { break-inside: avoid; }
    .role::after { display: none; }
    .role h3 { color: #101214 !important; }
  }
</style>
